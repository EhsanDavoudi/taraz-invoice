<Application x:Class="TarazInvoice.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:TarazInvoice.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================================== -->
            <!-- فونت فارسی وزیرمتن (Vazirmatn Persian Typography)                 -->
            <!-- ============================================================== -->
            <FontFamily x:Key="AppFontFamily">pack://application:,,,/TarazInvoice;component/Resources/Fonts/#Vazirmatn, ./Resources/Fonts/#Vazirmatn, Vazirmatn, Segoe UI, Tahoma, Arial</FontFamily>

            <!-- اعمال فونت پیش‌فرض سراسری برای کلیه کنترل‌های متنی و پنجره‌ها -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
                <Setter Property="TextElement.FontFamily" Value="{StaticResource AppFontFamily}"/>
            </Style>
            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            </Style>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            </Style>

            <!-- ============================================================== -->
            <!-- پالت رنگی و توکن‌های سازمانی مدرن تاراز (Slate & Cobalt Design System) -->
            <!-- ============================================================== -->

            <!-- WPF-UI Accent Overrides: یکپارچه‌سازی رنگ اصلی برنامه با آبی کبالت -->
            <Color x:Key="SystemAccentColor">#2563EB</Color>
            <Color x:Key="SystemAccentColorPrimary">#2563EB</Color>
            <Color x:Key="SystemAccentColorSecondary">#1D4ED8</Color>
            <Color x:Key="SystemAccentColorTertiary">#1E40AF</Color>
            <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#1E40AF" />

            <!-- رنگ‌های برند و اکشن اصلی (Primary Action) -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF" />
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EFF6FF" />

            <!-- سطوح و پس‌زمینه‌ها (Surfaces & Canvas) -->
            <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#F1F5F9" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#E2E8F0" />

            <!-- کادرها و جداکننده‌ها (Borders) -->
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E8F0" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1" />
            <SolidColorBrush x:Key="BorderAccentBrush" Color="#93C5FD" />

            <!-- تایپوگرافی و متن‌ها با کنتراست بالا (Typography - WCAG AA/AAA Compliant) -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

            <!-- رنگ‌های معنایی (Semantic Colors) -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
            <SolidColorBrush x:Key="SuccessLightBrush" Color="#ECFDF5" />
            <SolidColorBrush x:Key="SuccessBorderBrush" Color="#A7F3D0" />

            <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
            <SolidColorBrush x:Key="WarningLightBrush" Color="#FFFBEB" />
            <SolidColorBrush x:Key="WarningBorderBrush" Color="#FDE68A" />

            <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="DangerLightBrush" Color="#FEF2F2" />
            <SolidColorBrush x:Key="DangerBorderBrush" Color="#FECACA" />

            <!-- ============================================================== -->
            <!-- استایل اسکرول‌بار مینی‌مال فلوئنت پاپ‌آپ (Minimal Fluent ScrollBar) -->
            <!-- ============================================================== -->
            <Style x:Key="FluentComboBoxScrollBarThumb" TargetType="{x:Type Thumb}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border x:Name="ThumbBorder"
                                    Background="#CBD5E1"
                                    CornerRadius="3"
                                    Margin="1,0"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#94A3B8"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#64748B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FluentComboBoxScrollBar" TargetType="{x:Type ScrollBar}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Width" Value="6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource FluentComboBoxScrollBarThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================================================== -->
            <!-- استایل آیتم‌های کمبوباکس (Modern Fluent ComboBoxItem)            -->
            <!-- ============================================================== -->
            <Style TargetType="{x:Type ComboBoxItem}">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Margin" Value="2,1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                            <Border x:Name="ItemBorder"
                                    CornerRadius="6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- متن یا محتوای آیتم -->
                                    <ContentPresenter Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Stretch"
                                                      RecognizesAccessKey="False"/>
                                    <!-- تیک تایید انتخاب (Checkmark) -->
                                    <Path x:Name="Checkmark"
                                          Grid.Column="1"
                                          FlowDirection="LeftToRight"
                                          Data="M 1.5 6 L 4.5 9.5 L 11 2.5"
                                          Stroke="{StaticResource PrimaryBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"
                                          Margin="8,0,2,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#DBEAFE"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryHoverBrush}"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================================================== -->
            <!-- استایل و قالب کنترل سراسری کمبوباکس (Modern Fluent ComboBox)    -->
            <!-- ============================================================== -->
            <!-- دکمه تاشو (ToggleButton) کمبوباکس -->
            <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
                <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="7"
                        SnapsToDevicePixels="True">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <!-- آیکون فلش شیک و هندسی فلوئنت (Vector Chevron) -->
                        <Path x:Name="Chevron"
                              Grid.Column="1"
                              Data="M 0 1 L 4.5 5.5 L 9 1"
                              Stroke="#64748B"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                        <Setter TargetName="Border" Property="BorderBrush" Value="#94A3B8"/>
                        <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TextSecondaryBrush}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        <Setter TargetName="Border" Property="Background" Value="#FFFFFF"/>
                        <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                        <Setter TargetName="Chevron" Property="Data" Value="M 0 5.5 L 4.5 1 L 9 5.5"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Border" Property="Background" Value="{StaticResource CanvasBackgroundBrush}"/>
                        <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                        <Setter TargetName="Chevron" Property="Stroke" Value="#CBD5E1"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="MinWidth" Value="100"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="MaxDropDownHeight" Value="280"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid SnapsToDevicePixels="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <!-- دکمه تاگل سراسری به عنوان کادر و پس‌زمینه کل کمبوباکس -->
                                <ToggleButton x:Name="DropDownToggle"
                                              Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              Focusable="False"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"/>

                                <!-- گرید دو ستونه برای جداسازی قطعی محتوا از آیکون فلش (هماهنگ با RTL و LTR) -->
                                <Grid SnapsToDevicePixels="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ۱. نمایش متن یا آیتم در حالت انتخاب معمولی (Non-Editable) -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="12,0,6,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Stretch"
                                                      RecognizesAccessKey="False"/>

                                    <!-- ۲. جعبه متن ویرایش‌پذیر در صورت IsEditable=True (الزامی برای جلوگیری از شکستن سلکت‌ها) -->
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Margin="10,0,6,0"
                                             Focusable="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="2,0"
                                             Foreground="{TemplateBinding Foreground}"
                                             FontFamily="{TemplateBinding FontFamily}"
                                             FontSize="{TemplateBinding FontSize}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Visibility="Collapsed">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="{x:Type TextBox}">
                                                <Border Background="Transparent" SnapsToDevicePixels="True">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Background="Transparent"
                                                                  Focusable="False"
                                                                  HorizontalScrollBarVisibility="Hidden"
                                                                  VerticalScrollBarVisibility="Hidden"/>
                                                </Border>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                </Grid>

                                <!-- پنجره پاپ‌آپ لیست گزینه‌ها -->
                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade"
                                       VerticalOffset="3"
                                       FlowDirection="{TemplateBinding FlowDirection}">
                                    <Grid MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                          MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                          SnapsToDevicePixels="True">
                                        <Border x:Name="DropDownBorder"
                                                Margin="4"
                                                Background="{StaticResource SurfaceCardBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12"
                                                                  ShadowDepth="3"
                                                                  Direction="270"
                                                                  Color="#0F172A"
                                                                  Opacity="0.12"/>
                                            </Border.Effect>
                                            <ScrollViewer SnapsToDevicePixels="True"
                                                          Padding="4"
                                                          CanContentScroll="True"
                                                          Focusable="False">
                                                <ScrollViewer.Resources>
                                                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource FluentComboBoxScrollBar}"/>
                                                </ScrollViewer.Resources>
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter Property="IsTabStop" Value="False"/>
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="DropDownBorder" Property="MinHeight" Value="56"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource CanvasBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- استایل تب‌های سگمنتد وضعیت CRM -->
            <Style x:Key="StatusChipButton" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#475569"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="border" CornerRadius="7" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- استایل دکمه ثانویه کادردار استاندارد (Secondary Outline Button) -->
            <Style x:Key="SecondaryOutlineButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <!-- استایل دکمه‌های عملیات جدول (Table Action Button) -->
            <Style x:Key="TableActionButton" TargetType="ui:Button">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="9,3"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Button">
                            <Border x:Name="btnBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#F1F5F9"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#64748B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- استایل دکمه حذف ملایم بدون ایکون سیاه روی قرمز (Soft Danger Button) -->
            <Style x:Key="SoftDangerButton" TargetType="ui:Button">
                <Setter Property="Background" Value="#FEF2F2"/>
                <Setter Property="BorderBrush" Value="#FECACA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#DC2626"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Button">
                            <Border x:Name="dangerBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="dangerBorder" Property="Background" Value="#DC2626"/>
                                    <Setter TargetName="dangerBorder" Property="BorderBrush" Value="#DC2626"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="dangerBorder" Property="Background" Value="#B91C1C"/>
                                    <Setter TargetName="dangerBorder" Property="BorderBrush" Value="#B91C1C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- استایل مدرن ملایم دکمه خروجی اکسل (Soft Emerald Excel Button) -->
            <Style x:Key="ExcelExportButton" TargetType="ui:Button">
                <Setter Property="Background" Value="#F0FDF4"/>
                <Setter Property="BorderBrush" Value="#86EFAC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#15803D"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Button">
                            <Border x:Name="excelBorder" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="excelBorder" Property="Background" Value="#DCFCE7"/>
                                    <Setter TargetName="excelBorder" Property="BorderBrush" Value="#4ADE80"/>
                                    <Setter Property="Foreground" Value="#166534"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="excelBorder" Property="Background" Value="#BBF7D0"/>
                                    <Setter TargetName="excelBorder" Property="BorderBrush" Value="#22C55E"/>
                                    <Setter Property="Foreground" Value="#14532D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- استایل مدرن ملایم دکمه خروجی PDF (Soft Crimson PDF Button) -->
            <Style x:Key="PdfExportButton" TargetType="ui:Button">
                <Setter Property="Background" Value="#FEF2F2"/>
                <Setter Property="BorderBrush" Value="#FECACA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#DC2626"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Button">
                            <Border x:Name="pdfBorder" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="pdfBorder" Property="Background" Value="#FEE2E2"/>
                                    <Setter TargetName="pdfBorder" Property="BorderBrush" Value="#F87171"/>
                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="pdfBorder" Property="Background" Value="#FECDD3"/>
                                    <Setter TargetName="pdfBorder" Property="BorderBrush" Value="#EF4444"/>
                                    <Setter Property="Foreground" Value="#991B1B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- استایل مدرن ملایم دکمه چاپ و پیش‌نمایش (Soft Cobalt Print Button) -->
            <Style x:Key="PrintExportButton" TargetType="ui:Button">
                <Setter Property="Background" Value="#EFF6FF"/>
                <Setter Property="BorderBrush" Value="#BFDBFE"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#1D4ED8"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Button">
                            <Border x:Name="printBorder" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="printBorder" Property="Background" Value="#DBEAFE"/>
                                    <Setter TargetName="printBorder" Property="BorderBrush" Value="#93C5FD"/>
                                    <Setter Property="Foreground" Value="#1E40AF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="printBorder" Property="Background" Value="#BFDBFE"/>
                                    <Setter TargetName="printBorder" Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- استایل ملایم دکمه بازگشت و انصراف (Soft Slate Return Button) -->
            <Style x:Key="ReturnActionButton" TargetType="ui:Button">
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#475569"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Button">
                            <Border x:Name="retBorder" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="retBorder" Property="Background" Value="#F1F5F9"/>
                                    <Setter TargetName="retBorder" Property="BorderBrush" Value="#94A3B8"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="retBorder" Property="Background" Value="#E2E8F0"/>
                                    <Setter TargetName="retBorder" Property="BorderBrush" Value="#64748B"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- استایل DataGrid استاندارد سازمانی با خطوط تفکیک سراسری، هدر شفاف و سطر پیوسته -->
            <Style TargetType="DataGrid">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
                <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
                <Setter Property="MinRowHeight" Value="44"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
            </Style>

            <!-- سرستون‌های DataGrid: کاملاً در مرکز با خطوط تفکیک زیرین و راست همراه با نشانگر مرتب‌سازی هوشمند -->
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Padding="{TemplateBinding Padding}" 
                                    SnapsToDevicePixels="True">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Grid x:Name="SortIconContainer" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                            <!-- آیکون خنثی قبل از سورت (نشان‌دهنده قابل سورت بودن) -->
                                            <ui:SymbolIcon x:Name="SortIconNeutral" Symbol="ArrowSort20" FontSize="11" Foreground="#94A3B8"/>
                                            <!-- آیکون صعودی -->
                                            <ui:SymbolIcon x:Name="SortIconAsc" Symbol="ArrowUp20" FontSize="11" Foreground="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
                                            <!-- آیکون نزولی -->
                                            <ui:SymbolIcon x:Name="SortIconDesc" Symbol="ArrowDown20" FontSize="11" Foreground="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="CanUserSort" Value="True">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter TargetName="SortIconContainer" Property="Visibility" Value="Visible"/>
                                    <Setter Property="ToolTip" Value="کلیک جهت مرتب‌سازی این ستون"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter TargetName="SortIconNeutral" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="SortIconAsc" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="SortIconDesc" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter TargetName="SortIconNeutral" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="SortIconAsc" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="SortIconDesc" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- سلول‌های DataGrid: پر کردن تمام ارتفاع سطر و ترازبندی در مرکز بدون شکستگی خطوط -->
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderThickness="0" 
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ردیف‌های DataGrid: خط زیرین سراسری یکپارچه و هایلایت نرم بدون انقطاع -->
            <Style TargetType="DataGridRow">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="MinHeight" Value="44"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#EFF6FF"/>
                        <Setter Property="Foreground" Value="#1E3A8A"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F8FAFC"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ثبت کانورترهای برنامه -->
            <converters:StatusToStringConverter x:Key="StatusToStringConverter"/>
            <converters:StatusToColorBrushConverter x:Key="StatusToColorBrushConverter"/>
            <converters:StatusToBgColorBrushConverter x:Key="StatusToBgColorBrushConverter"/>
            <converters:CurrencyFormatConverter x:Key="CurrencyFormatConverter"/>
            <converters:DecimalNumberConverter x:Key="DecimalNumberConverter"/>
            <converters:NullablePercentConverter x:Key="NullablePercentConverter"/>
            <converters:NullablePercentDisplayConverter x:Key="NullablePercentDisplayConverter"/>
            <converters:NotApprovedToVisibilityConverter x:Key="NotApprovedToVisibilityConverter"/>
            <converters:QuantityConverter x:Key="QuantityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
