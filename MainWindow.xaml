<ui:FluentWindow x:Class="TarazInvoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:TarazInvoice"
        mc:Ignorable="d"
        Title="تـراز (v0.2.0-beta) - سامانه جامع صدور و مدیریت پیش‌فاکتور"
        Height="880" Width="1400"
        MinHeight="740" MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        FlowDirection="LeftToRight"
        FontFamily="{StaticResource AppFontFamily}"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        Icon="/Resources/logo.png"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <!-- نوار عنوان استاندارد ویندوز ۱۱ با دکمه‌های [X] و [...] در بالا-راست -->
            <RowDefinition Height="Auto"/>
            <!-- محیط کاری اصلی برنامه -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- نوار عنوان فلوئنت ویندوز ۱۱ -->
        <ui:TitleBar Grid.Row="0" Title="تـراز | سامانه جامع صدور و مدیریت پیش‌فاکتور (v0.2.0-beta)" />

        <!-- ساختار اصلی برنامه با جهت کاملاً بومی راست‌چین فارسی -->
        <Grid Grid.Row="1" FlowDirection="RightToLeft">
            <Grid.ColumnDefinitions>
                <!-- سایدبار ناوبری (در حالت RTL در سمت راست پنجره قرار می‌گیرد) -->
                <ColumnDefinition Width="260"/>
                <!-- صفحه کاری محتوا (در حالت RTL در سمت چپ سایدبار قرار می‌گیرد) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== سایدبار ناوبری (TARAZ Sidebar) ==================== -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- برندینگ و لوگوی رسمی تراز -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,4,0,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- تصویر لوگوی رسمی تراز -->
                            <Border Width="44" Height="44" CornerRadius="10" Background="Transparent" Margin="0,0,12,0" ClipToBounds="True">
                                <Image Source="/Resources/logo.png" Width="44" Height="44" Stretch="Uniform"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="تـراز" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="سامانه مدیریت پیش‌فاکتور" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- دکمه برجسته صدور پیش‌فاکتور جدید -->
                    <ui:Button Grid.Row="1" Appearance="Primary" Height="44" Margin="2,0,2,18" HorizontalAlignment="Stretch"
                               Icon="{ui:SymbolIcon Symbol=AddCircle24}" Content="صدور پیش‌فاکتور جدید" 
                               FontSize="13" FontWeight="Bold" Click="BtnNewInvoice_Click"/>

                    <!-- منوی ناوبری سایدبار با پشتیبانی از هایلایت فعال و تغییر ظاهر -->
                    <StackPanel Grid.Row="2" Margin="0,2">
                        <!-- فهرست پیش‌فاکتورها -->
                        <Border x:Name="NavCardInvoices" Tag="Invoices" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,3"
                                MouseEnter="NavCard_MouseEnter" MouseLeave="NavCard_MouseLeave">
                            <Button x:Name="NavBtnInvoices" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="44" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavBtn_Click" Tag="Invoices" 
                                    Cursor="Hand" Padding="14,0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="14,0">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="NavIconInvoices" Symbol="DocumentBulletList24" Margin="0,0,12,0" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="NavTextInvoices" Text="فهرست پیش‌فاکتورها" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- فرم ثبت / ویرایش فاکتور -->
                        <Border x:Name="NavCardEditor" Tag="Editor" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,3"
                                MouseEnter="NavCard_MouseEnter" MouseLeave="NavCard_MouseLeave">
                            <Button x:Name="NavBtnEditor" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="44" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavBtn_Click" Tag="Editor" 
                                    Cursor="Hand" Padding="14,0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="14,0">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="NavIconEditor" Symbol="Edit24" Margin="0,0,12,0" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="NavTextEditor" Text="فرم ثبت / ویرایش فاکتور" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- انبار و کالاها -->
                        <Border x:Name="NavCardStorage" Tag="Storage" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,3"
                                MouseEnter="NavCard_MouseEnter" MouseLeave="NavCard_MouseLeave">
                            <Button x:Name="NavBtnStorage" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="44" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavBtn_Click" Tag="Storage" 
                                    Cursor="Hand" Padding="14,0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="14,0">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="NavIconStorage" Symbol="Cube24" Margin="0,0,12,0" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="NavTextStorage" Text="انبار و کالاها" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- گزارشات جامع -->
                        <Border x:Name="NavCardReports" Tag="Reports" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,3"
                                MouseEnter="NavCard_MouseEnter" MouseLeave="NavCard_MouseLeave">
                            <Button x:Name="NavBtnReports" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="44" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavBtn_Click" Tag="Reports" 
                                    Cursor="Hand" Padding="14,0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="14,0">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="NavIconReports" Symbol="DataTrending24" Margin="0,0,12,0" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="NavTextReports" Text="گزارشات جامع" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- شرکت‌ها (طرف حساب) -->
                        <Border x:Name="NavCardCompanies" Tag="Companies" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,3"
                                MouseEnter="NavCard_MouseEnter" MouseLeave="NavCard_MouseLeave">
                            <Button x:Name="NavBtnCompanies" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="44" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavBtn_Click" Tag="Companies" 
                                    Cursor="Hand" Padding="14,0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="14,0">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="NavIconCompanies" Symbol="Building24" Margin="0,0,12,0" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="NavTextCompanies" Text="شرکت‌ها (طرف حساب)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- کارشناسان و شماره‌انداز -->
                        <Border x:Name="NavCardExperts" Tag="Experts" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,3"
                                MouseEnter="NavCard_MouseEnter" MouseLeave="NavCard_MouseLeave">
                            <Button x:Name="NavBtnExperts" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="44" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavBtn_Click" Tag="Experts" 
                                    Cursor="Hand" Padding="14,0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="14,0">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="NavIconExperts" Symbol="People24" Margin="0,0,12,0" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="NavTextExperts" Text="کارشناسان و شماره‌انداز" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- قالب اکسل و تنظیمات -->
                        <Border x:Name="NavCardSettings" Tag="Settings" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,3"
                                MouseEnter="NavCard_MouseEnter" MouseLeave="NavCard_MouseLeave">
                            <Button x:Name="NavBtnSettings" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="44" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavBtn_Click" Tag="Settings" 
                                    Cursor="Hand" Padding="14,0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="14,0">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="NavIconSettings" Symbol="Settings24" Margin="0,0,12,0" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="NavTextSettings" Text="تنظیمات و سربرگ پیش‌فاکتور" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>

                    <!-- نشانگر وضعیت پایگاه داده محلی در انتهای سایدبار -->
                    <Border Grid.Row="3" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="پایگاه داده محلی فعال" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="داده‌ها ۱۰۰٪ آفلاین و محلی ذخیره می‌شوند" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== محیط کاری محتوا (راست‌چین فارسی) ==================== -->
            <Grid Grid.Column="1" Background="{StaticResource CanvasBackgroundBrush}">
                <Grid.RowDefinitions>
                    <!-- هدر صفحه با عنوان و تاریخ -->
                    <RowDefinition Height="64"/>
                    <!-- محتوای تعاملی صفحه -->
                    <RowDefinition Height="*"/>
                    <!-- نوار وضعیت پایین -->
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- هدر صفحه -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- عنوان و توضیح خوانا -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPageTitle" Text="فهرست و کارتابل پیش‌فاکتورها" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtPageSubtitle" Text="رهگیری وضعیت فروش، خروجی تمیز اکسل برای مشتریان و چاپ مستقیم رسمی" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- تاریخ شمسی زیبا در سمت چپ هدر -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="CalendarLtr24" Margin="0,0,8,0" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock x:Name="TxtCurrentDate" Text="امروز: ۱۴۰۳/۰۶/۱۵" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== صفحات مختلف ==================== -->
                <Grid Grid.Row="1">

                    <!-- ۱. صفحه پیش‌فاکتورها (Dashboard & Table) -->
                    <Grid x:Name="ViewInvoices" Margin="24" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <!-- ۴ کارت شاخص‌های کلیدی فروش (CRM KPI Cards) -->
                            <RowDefinition Height="Auto"/>
                            <!-- نوار فیلتر و جستجوی سریع -->
                            <RowDefinition Height="Auto"/>
                            <!-- جدول پیش‌فاکتورها (بدون ستون‌های زائد) -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- بخش ۱: کارت‌های شاخص‌های کلیدی CRM -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- کارت ۱: کل ارزش پیش‌فاکتورها -->
                            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="کل مبالغ پیش‌فاکتورها" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtKpiTotalAmount" Text="0 ریال" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtKpiTotalCount" Text="تعداد: 0 فاکتور صادرشده" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{StaticResource PrimaryLightBrush}" VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="DocumentBulletList24" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- کارت ۲: مجموع سود پیش‌فاکتورها -->
                            <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="مجموع سود پیش‌فاکتورها" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtKpiTotalProfit" Text="0 ریال" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtKpiProfitMargin" Text="سود ناخالص فروش" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{StaticResource SuccessLightBrush}" VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="Money24" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- کارت ۳: تأیید شده (فروش قطعی) -->
                            <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="پیش‌فاکتورهای تأیید شده" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtKpiApprovedAmount" Text="0 ریال" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtKpiApprovedCount" Text="تعداد: 0 تأیید نهایی" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{StaticResource PrimaryLightBrush}" VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- کارت ۴: در انتظار پیگیری فروش -->
                            <Border Grid.Column="3" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="در انتظار پیگیری و ارسال" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtKpiPendingCount" Text="0 پیش‌فاکتور" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/>
                                        <TextBlock Text="نیازمند تماس کارشناس" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{StaticResource WarningLightBrush}" VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="Clock24" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- کارت ۵: شرکت‌ها و کارشناسان فعال -->
                            <Border Grid.Column="4" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="مشتریان و کارشناسان" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtKpiCompaniesCount" Text="0 شرکت" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtKpiExpertsCount" Text="0 کارشناس فعال" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{StaticResource SurfaceSubtleBrush}" VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="Building24" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- بخش ۲: جعبه فیلتر وضعیت و جستجو -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- چیپ‌های وضعیت پیش‌فاکتورها -->
                                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="فیلتر وضعیت:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"/>
                                        
                                        <RadioButton x:Name="ChipStatusAll" Content="همه وضعیت‌ها" Style="{StaticResource StatusChipButton}" 
                                                     IsChecked="True" Checked="ChipStatus_Checked"/>

                                        <RadioButton x:Name="ChipStatusPreparingGoods" Content="تهیه کالا" Style="{StaticResource StatusChipButton}" 
                                                     Checked="ChipStatus_Checked"/>

                                        <RadioButton x:Name="ChipStatusSent" Content="ارسال شده" Style="{StaticResource StatusChipButton}" 
                                                     Checked="ChipStatus_Checked"/>

                                        <RadioButton x:Name="ChipStatusNotSent" Content="ارسال نشده" Style="{StaticResource StatusChipButton}" 
                                                     Checked="ChipStatus_Checked"/>

                                        <RadioButton x:Name="ChipStatusPaid" Content="هزینه واریز شده" Style="{StaticResource StatusChipButton}" 
                                                     Checked="ChipStatus_Checked"/>

                                        <RadioButton x:Name="ChipStatusUnpaid" Content="واریز نشده" Style="{StaticResource StatusChipButton}" 
                                                     Checked="ChipStatus_Checked"/>

                                        <RadioButton x:Name="ChipStatusApproved" Content="تأیید شده" Style="{StaticResource StatusChipButton}" 
                                                     Checked="ChipStatus_Checked"/>

                                        <RadioButton x:Name="ChipStatusDraft" Content="پیش‌نویس" Style="{StaticResource StatusChipButton}" 
                                                     Checked="ChipStatus_Checked"/>

                                        <RadioButton x:Name="ChipStatusPending" Content="در انتظار تأیید" Style="{StaticResource StatusChipButton}" 
                                                     Checked="ChipStatus_Checked"/>

                                        <RadioButton x:Name="ChipStatusCanceled" Content="لغو شده" Style="{StaticResource StatusChipButton}" 
                                                     Checked="ChipStatus_Checked"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- فیلدهای جستجو، فیلتر کارشناس، فیلتر ماه و فیلتر شرکت -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- جستجوی آنی -->
                                    <ui:TextBox x:Name="TxtSearchInvoice" Grid.Column="0" Margin="0,0,8,0" 
                                                PlaceholderText="جستجو در شماره فاکتور، نام شرکت یا کارشناس..."
                                                Icon="{ui:SymbolIcon Symbol=Search24}" ClearButtonEnabled="True"
                                                TextChanged="TxtSearchInvoice_TextChanged"/>

                                    <!-- فیلتر کارشناس -->
                                    <ComboBox x:Name="CmbFilterExpert" Grid.Column="1" Height="36" HorizontalAlignment="Stretch" Margin="0,0,8,0" SelectionChanged="CmbFilterExpert_SelectionChanged"/>

                                    <!-- فیلتر ماه -->
                                    <ComboBox x:Name="CmbFilterMonth" Grid.Column="2" Height="36" HorizontalAlignment="Stretch" Margin="0,0,8,0" SelectionChanged="CmbFilterMonth_SelectionChanged"/>

                                    <!-- فیلتر شرکت -->
                                    <ComboBox x:Name="CmbFilterCompany" Grid.Column="3" Height="36" HorizontalAlignment="Stretch" Margin="0,0,8,0" SelectionChanged="CmbFilterCompany_SelectionChanged"/>

                                    <!-- دکمه رفرش -->
                                    <ui:Button Grid.Column="4" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" 
                                               Content="بروزرسانی" Click="BtnRefreshInvoices_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                            <DataGrid x:Name="DgrInvoices" AutoGenerateColumns="False" SelectionMode="Single"
                                      CanUserResizeColumns="True" CanUserSortColumns="True"
                                      PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp"
                                      MouseDoubleClick="DgrInvoices_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <!-- شماره فاکتور -->
                                    <DataGridTemplateColumn Width="1.2*" MinWidth="115">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="شماره فاکتور" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding InvoiceNumber}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- نام شرکت خریدار -->
                                    <DataGridTemplateColumn Width="2.2*" MinWidth="160">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="شرکت خریدار (طرف حساب)" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
                                                    <TextBlock Text="{Binding CompanyName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                                        <ui:SymbolIcon Symbol="Call20" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding CompanyPhone}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- کارشناس صادرکننده -->
                                    <DataGridTemplateColumn Width="1.3*" MinWidth="120">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="کارشناس صادرکننده" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
                                                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Person20" Foreground="{StaticResource PrimaryBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding ExpertName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- تاریخ صدور -->
                                    <DataGridTemplateColumn Width="1.0*" MinWidth="95">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="تاریخ صدور" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding IssueDateShamsi}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- مهلت اعتبار -->
                                    <DataGridTemplateColumn Width="1.0*" MinWidth="95">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="مهلت اعتبار" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ValidUntilShamsi}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- مبلغ کل (ریال) -->
                                    <DataGridTemplateColumn Width="1.3*" MinWidth="120">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="مبلغ کل (ریال)" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N0}}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="ریال" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="4,1,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- ستون سود پیش‌فاکتور (سود ما) -->
                                    <DataGridTemplateColumn Width="1.2*" MinWidth="110">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="سود پیش‌فاکتور" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SuccessLightBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding TotalProfit, StringFormat={}{0:N0}}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                                                        <TextBlock Text="ریال" FontSize="10" Foreground="{StaticResource SuccessBrush}" Margin="4,1,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <!-- وضعیت رنگی ۵ گانه -->
                                    <DataGridTemplateColumn Width="1.1*" MinWidth="100">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="وضعیت" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{Binding Status, Converter={StaticResource StatusToBgColorBrushConverter}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToStringConverter}}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToColorBrushConverter}}"
                                                               FontWeight="Bold" FontSize="11.5"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- دکمه‌های عملیاتی مرتب و منوی شناور -->
                                    <DataGridTemplateColumn Width="3.4*" MinWidth="320">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="عملیات و خروجی" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- تأیید و چاپ مستقیم -->
                                                    <ui:Button Style="{StaticResource TableActionButton}" Margin="2,0"
                                                               ToolTip="تأیید پیش‌فاکتور و ارسال به چاپ" Click="BtnApproveAndPrintRow_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="CheckmarkCircle20" Foreground="{StaticResource SuccessBrush}" Margin="0,0,4,0" FontSize="15"/>
                                                            <TextBlock Text="تأیید و چاپ" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ui:Button>

                                                    <!-- چاپ و PDF -->
                                                    <ui:Button Style="{StaticResource TableActionButton}" Margin="2,0"
                                                               ToolTip="چاپ مستقیم یا خروجی PDF رسمی A4" Click="BtnPrintPdf_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Print20" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,5,0" FontSize="15"/>
                                                            <TextBlock Text="چاپ" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ui:Button>

                                                    <!-- اکسل مشتری -->
                                                    <ui:Button Style="{StaticResource TableActionButton}" Margin="2,0"
                                                               ToolTip="خروجی فایل اکسل فقط با ستون‌های نهایی مشتری" Click="BtnExportExcel_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="DocumentTable20" Foreground="{StaticResource SuccessBrush}" Margin="0,0,5,0" FontSize="15"/>
                                                            <TextBlock Text="اکسل" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ui:Button>

                                                    <!-- ذخیره PDF -->
                                                    <ui:Button Style="{StaticResource TableActionButton}" Margin="2,0"
                                                               ToolTip="ذخیره پیش‌فاکتور به صورت فایل PDF" Click="BtnExportPdf_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="DocumentPdf20" Foreground="{StaticResource DangerBrush}" Margin="0,0,5,0" FontSize="15"/>
                                                            <TextBlock Text="PDF" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ui:Button>

                                                    <!-- ویرایش مستقیم -->
                                                    <ui:Button Style="{StaticResource TableActionButton}" Padding="6,3" Margin="2,0"
                                                               ToolTip="ویرایش پیش‌فاکتور" Click="MenuItem_Edit_Click">
                                                        <ui:SymbolIcon Symbol="Edit20" Foreground="{StaticResource PrimaryBrush}" FontSize="14"/>
                                                    </ui:Button>

                                                    <!-- حذف ملایم و شیک (بدون ضربدر سیاه روی کادر قرمز!) -->
                                                    <ui:Button Style="{StaticResource SoftDangerButton}" Margin="2,0"
                                                               ToolTip="حذف پیش‌فاکتور" Click="BtnDeleteInvoice_Click">
                                                        <ui:SymbolIcon Symbol="Delete20" FontSize="14" 
                                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=ui:Button}, Path=Foreground}"/>
                                                    </ui:Button>

                                                    <!-- سایر گزینه‌ها / منوی ۳ نقطه -->
                                                    <ui:Button Style="{StaticResource TableActionButton}" Padding="6,3" Margin="2,0"
                                                               ToolTip="سایر عملیات (کپی، تغییر وضعیت)" Click="BtnMoreOptions_Click">
                                                        <ui:SymbolIcon Symbol="MoreHorizontal20" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                                        <ui:Button.ContextMenu>
                                                            <ContextMenu FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}">
                                                                <MenuItem Header="تأیید و چاپ پیش‌فاکتور" Click="BtnApproveAndPrintRow_Click">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="CheckmarkCircle20" Foreground="{StaticResource SuccessBrush}"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="ویرایش پیش‌فاکتور (دابل‌کلیک)" Click="MenuItem_Edit_Click">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="Edit20" Foreground="{StaticResource PrimaryBrush}"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="کپی فاکتور با شماره جدید کارشناس" Click="MenuItem_Duplicate_Click">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="Copy20" Foreground="{StaticResource PrimaryBrush}"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="تغییر وضعیت پیش‌فاکتور">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="ArrowSync20" Foreground="{StaticResource PrimaryBrush}"/>
                                                                    </MenuItem.Icon>
                                                                    <MenuItem Header="تهیه کالا" Click="MenuItem_SetStatus_Click" Tag="PreparingGoods"/>
                                                                    <MenuItem Header="ارسال شده" Click="MenuItem_SetStatus_Click" Tag="Sent"/>
                                                                    <MenuItem Header="ارسال نشده" Click="MenuItem_SetStatus_Click" Tag="NotSent"/>
                                                                    <MenuItem Header="هزینه واریز شده" Click="MenuItem_SetStatus_Click" Tag="Paid"/>
                                                                    <MenuItem Header="واریز نشده" Click="MenuItem_SetStatus_Click" Tag="Unpaid"/>
                                                                    <MenuItem Header="تأیید شده (همراه با چاپ)" Click="MenuItem_SetStatus_Click" Tag="Approved"/>
                                                                    <MenuItem Header="پیش‌نویس" Click="MenuItem_SetStatus_Click" Tag="Draft"/>
                                                                    <MenuItem Header="در انتظار تأیید" Click="MenuItem_SetStatus_Click" Tag="Pending"/>
                                                                    <MenuItem Header="لغو شده" Click="MenuItem_SetStatus_Click" Tag="Canceled"/>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="حذف پیش‌فاکتور" Foreground="{StaticResource DangerBrush}" Click="MenuItem_Delete_Click">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="Delete20" Foreground="{StaticResource DangerBrush}"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </ui:Button.ContextMenu>
                                                    </ui:Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- ۲. صفحه فرم صدور / ویرایش پیش‌فاکتور -->
                    <Grid x:Name="ViewInvoiceEditor" Margin="24" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- کارت‌های اطلاعات طرفین -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- کارت خریدار -->
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="مشخصات شرکت خریدار (طرف حساب)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <ui:Button Grid.Column="1" Appearance="Secondary" Padding="10,3" FontSize="11" Content="+ ثبت شرکت جدید" Click="BtnQuickAddCompany_Click"/>
                                            </Grid>

                                            <TextBlock Text="انتخاب شرکت:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbEditorCompany" DisplayMemberPath="Name" SelectionChanged="CmbEditorCompany_SelectionChanged" Height="36" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="پیشوند عنوان مشتری (مثلاً 'نام مشتری شرکت محترم '):" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtEditorCustomerPrefix" Text="نام مشتری شرکت محترم "/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="موضوع پیش‌فاکتور:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtEditorSubject" PlaceholderText="اختیاری..."/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="تلفن تماس:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtEditorCompanyPhone"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="شناسه ملی / کد اقتصادی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtEditorCompanyEcoCode"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="نشانی کامل:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                            <ui:TextBox x:Name="TxtEditorCompanyAddress"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- کارت پیش‌فاکتور و کارشناس -->
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="مشخصات پیش‌فاکتور و کارشناس صادرکننده" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="کارشناس صادرکننده:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBlock x:Name="TxtExpertCounterHint" Text="" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="Bold" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                    <ComboBox x:Name="CmbEditorExpert" DisplayMemberPath="FullName" Height="36" HorizontalAlignment="Stretch" SelectionChanged="CmbEditorExpert_SelectionChanged"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="شماره پیش‌فاکتور (سریال اختصاصی):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                    <ui:TextBox x:Name="TxtEditorInvoiceNumber" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="تاریخ صدور:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtEditorIssueDate"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                                    <TextBlock Text="مهلت اعتبار:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtEditorValidUntil"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                                    <TextBlock Text="وضعیت فاکتور:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox x:Name="CmbEditorStatus" Height="36" HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="واحد پول فاکتور:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox x:Name="CmbEditorCurrencyUnit" Height="36" HorizontalAlignment="Stretch" IsEnabled="False">
                                                        <ComboBoxItem Content="ریال" IsSelected="True"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                                    <TextBlock Text="پیوست:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtEditorAttachment" Text="ندارد"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                                    <TextBlock Text="صفحه:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtEditorPageNumberText" Text="یک"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- جدول اقلام پیش‌فاکتور -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="اقلام و محصولات پیش‌فاکتور" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="محاسبه همزمان قیمت خام، تخفیف، تقسیم بر ۱.۱، درصد و مبلغ سود، قیمت نهایی و سود ناخالص هر سطر." 
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- دکمه افزودن محصول جدید -->
                                            <ui:Button Grid.Column="1" Appearance="Secondary" Padding="14,6" Click="BtnAddItem_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Add24" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="افزودن سطر خالی" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:Button>
                                        </Grid>

                                        <!-- نوار جستجو و انتخاب سریع کالا از انبار با درصد تخفیف و سود -->
                                        <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.3*"/>
                                                    <ColumnDefinition Width="0.65*"/>
                                                    <ColumnDefinition Width="0.65*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="0.65*"/>
                                                    <ColumnDefinition Width="0.65*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="انتخاب یا جستجوی کالا از انبار (کالا یا شرح را تایپ کنید):" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <Grid>
                                                        <ui:TextBox x:Name="TxtQuickItemName" PlaceholderText="نام کالا را تایپ کنید..." TextChanged="TxtQuickItemName_TextChanged"/>
                                                        <Popup x:Name="PopupQuickSuggestions" PlacementTarget="{Binding ElementName=TxtQuickItemName}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" MaxHeight="280" MinWidth="460" Margin="0,4,0,0">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
                                                                </Border.Effect>
                                                                <ListBox x:Name="LstQuickSuggestions" BorderThickness="0" Background="Transparent" 
                                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                         SelectionChanged="LstQuickSuggestions_SelectionChanged" Cursor="Hand">
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Padding="10,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" TextWrapping="Wrap"/>
                                                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                                            <TextBlock Text="{Binding Code, StringFormat='کد: {0}'}" FontSize="10.5" Foreground="#64748B" Margin="0,0,10,0"/>
                                                                                            <TextBlock Text="{Binding Category, StringFormat='دسته: {0}'}" FontSize="10.5" Foreground="#94A3B8"/>
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0">
                                                                                        <TextBlock Text="{Binding DefaultPrice, StringFormat='{}{0:N0}'}" FontWeight="Bold" FontSize="13" Foreground="#0284C7" HorizontalAlignment="Right"/>
                                                                                        <TextBlock Text="{Binding Unit, StringFormat='واحد: {0}'}" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                                    <TextBlock Text="تعداد:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtQuickItemQty" Text="1" TextAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Margin="3,0,3,0">
                                                    <TextBlock Text="واحد:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox x:Name="CmbQuickItemUnit" Height="36" HorizontalAlignment="Stretch" IsEditable="True"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Margin="3,0,4,0">
                                                    <TextBlock Text="قیمت خام (ریال):" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtQuickItemPrice" Text="0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" Margin="3,0,4,0">
                                                    <TextBlock Text="تخفیف % *:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtQuickItemDiscount" Text="" PlaceholderText="الزامی" TextAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="5" Margin="3,0,6,0">
                                                    <TextBlock Text="سود % *:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtQuickItemProfit" Text="" PlaceholderText="الزامی" TextAlignment="Center"/>
                                                </StackPanel>

                                                <ui:Button Grid.Column="6" Appearance="Primary" VerticalAlignment="Bottom" Height="38" Padding="14,0" Click="BtnQuickAddItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Add24" Margin="0,0,4,0"/>
                                                        <TextBlock Text="افزودن به پیش‌فاکتور" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ui:Button>
                                            </Grid>
                                        </Border>

                                        <!-- نوار عملیات گروهی تخفیف، سود و فرمول ۱.۱ (اعمال به سطرهای انتخابی یا همه سطرها) -->
                                        <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="عملیات گروهی اقلام:" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                <!-- تخفیف گروهی -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="تخفیف %:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <ui:TextBox x:Name="TxtBulkDiscountPercent" PlaceholderText="%" Width="52" Height="32" TextAlignment="Center" Margin="0,0,4,0"/>
                                                    <ui:Button Appearance="Secondary" Content="اعمال تخفیف" Padding="6,3" Height="32" FontSize="10.5" Click="BtnApplyBulkDiscount_Click" ToolTip="اعمال درصد تخفیف به سطرهای انتخابی (یا تمام سطرها در صورت عدم انتخاب)"/>
                                                </StackPanel>

                                                <!-- سود گروهی -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="سود %:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <ui:TextBox x:Name="TxtBulkProfitPercent" PlaceholderText="%" Width="52" Height="32" TextAlignment="Center" Margin="0,0,4,0"/>
                                                    <ui:Button Appearance="Secondary" Content="اعمال سود" Padding="6,3" Height="32" FontSize="10.5" Click="BtnApplyBulkProfit_Click" ToolTip="اعمال درصد سود به سطرهای انتخابی (یا تمام سطرها در صورت عدم انتخاب)"/>
                                                </StackPanel>

                                                <!-- اعمال همزمان تخفیف و سود -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <ui:Button Appearance="Primary" Content="اعمال تخفیف و سود (یکجا)" Padding="10,3" Height="32" FontSize="11" FontWeight="Bold" Click="BtnApplyBulkBoth_Click" ToolTip="تنظیم همزمان درصد تخفیف و سود واردشده روی سطرهای انتخابی با یک کلیک"/>
                                                </StackPanel>

                                                <!-- فرمول ۱.۱ گروهی -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Appearance="Secondary" Content="تقسیم بر ۱.۱" Padding="8,3" Height="32" FontSize="10.5" Click="BtnApplyBulk1Point1_Click" ToolTip="فعال‌سازی تقسیم بر ۱.۱ برای سطرها"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- پاپ‌آپ پیشنهادات جستجوی انبار در جدول اقلام -->
                                        <Popup x:Name="PopupGridSuggestions" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" MaxHeight="260" Width="400" Padding="4">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="12" Opacity="0.15" ShadowDepth="4" Direction="270"/>
                                                </Border.Effect>
                                                <ListBox x:Name="LstGridSuggestions" BorderThickness="0" Background="Transparent"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         PreviewMouseLeftButtonUp="LstGridSuggestions_PreviewMouseLeftButtonUp"
                                                         KeyDown="LstGridSuggestions_KeyDown">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="8,6" Margin="0,1" CornerRadius="6" Background="Transparent">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" TextWrapping="Wrap"/>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                            <TextBlock Text="{Binding Code, StringFormat='کد: {0}'}" FontSize="10.5" Foreground="#64748B" Margin="0,0,12,0"/>
                                                                            <TextBlock Text="{Binding Category, StringFormat='دسته: {0}'}" FontSize="10.5" Foreground="#64748B"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                        <TextBlock Text="{Binding DefaultPrice, StringFormat='{}{0:N0} ریال'}" FontWeight="Bold" FontSize="12" Foreground="#0284C7" HorizontalAlignment="Right"/>
                                                                        <TextBlock Text="{Binding Unit, StringFormat='واحد: {0}'}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Popup>

                                        <DataGrid x:Name="DgrInvoiceItems" AutoGenerateColumns="False" CanUserAddRows="False" 
                                                  SelectionMode="Extended" SelectionUnit="CellOrRowHeader" RowHeight="52"
                                                  PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp"
                                                  MinHeight="180" MaxHeight="450" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <!-- ردیف -->
                                                <DataGridTextColumn Header="ردیف" Binding="{Binding RowNumber}" Width="0.5*" MinWidth="42" IsReadOnly="True"/>
                                                
                                                <!-- ستون محصول (نام کالا یا خدمات) با جستجوی هوشمند در انبار -->
                                                <DataGridTemplateColumn Header="محصول (شرح کالا یا خدمات) *" Width="2.8*" MinWidth="180">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="2" Cursor="IBeam">
                                                                <TextBlock Text="{Binding ItemName}" 
                                                                           VerticalAlignment="Center" HorizontalAlignment="Right" 
                                                                           TextAlignment="Right" TextWrapping="Wrap" 
                                                                           FontSize="13" FontWeight="SemiBold" 
                                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <Grid VerticalAlignment="Center" Margin="2">
                                                                <ui:TextBox x:Name="TxtGridItemName"
                                                                            Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" 
                                                                            PlaceholderText="نام کالا یا جستجو در انبار..."
                                                                            FontSize="13" FontWeight="SemiBold"
                                                                            Height="38" Padding="8,4"
                                                                            VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                                            Loaded="TxtGridItemName_Loaded"
                                                                            TextChanged="TxtGridItemName_TextChanged"
                                                                            PreviewKeyDown="TxtGridItemName_PreviewKeyDown"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                
                                                <!-- تعداد -->
                                                <DataGridTemplateColumn Header="تعداد *" Width="0.7*" MinWidth="55">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="2" Cursor="IBeam">
                                                                <TextBlock Text="{Binding Quantity, StringFormat={}{0:G29}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ui:TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G29}}" TextAlignment="Center" Height="38" Padding="4" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- واحد کالا (عدد، دستگاه، متر، ...) -->
                                                <DataGridTemplateColumn Header="واحد" Width="0.6*" MinWidth="50">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="2" Cursor="IBeam">
                                                                <TextBlock Text="{Binding Unit}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ui:TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Height="38" Padding="4" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                
                                                <!-- قیمت خام واحد -->
                                                <DataGridTemplateColumn x:Name="ColRawPrice" Header="قیمت خام (ریال)" Width="1.2*" MinWidth="100">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="2" Cursor="IBeam">
                                                                <TextBlock Text="{Binding RawPrice, StringFormat={}{0:N0}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ui:TextBox Text="{Binding RawPrice, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalNumberConverter}}" TextAlignment="Center" Height="38" Padding="4" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                
                                                <!-- درصد تخفیف فروش (الزامی حتی اگر صفر باشد) -->
                                                <DataGridTemplateColumn x:Name="ColDiscountPercent" Header="تخفیف % *" Width="0.75*" MinWidth="65">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="2" Cursor="IBeam">
                                                                <TextBlock Text="{Binding DiscountPercent, Converter={StaticResource NullablePercentDisplayConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ui:TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullablePercentConverter}}" PlaceholderText="الزامی" TextAlignment="Center" Height="38" Padding="4" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                
                                                <!-- مبلغ تخفیف واحد -->
                                                <DataGridTemplateColumn x:Name="ColDiscountAmount" Header="مبلغ تخفیف (ریال)" Width="1.1*" MinWidth="90">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="2" Cursor="IBeam">
                                                                <TextBlock Text="{Binding DiscountAmount, StringFormat={}{0:N0}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ui:TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalNumberConverter}}" TextAlignment="Center" Height="38" Padding="4" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- تیک ویژه محاسبه تقسیم بر ۱.۱ با تک‌کلیک سریع -->
                                                <DataGridTemplateColumn x:Name="Col1Point1" Header="تقسیم بر ۱.۱" Width="0.9*" MinWidth="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsDividedBy1Point1, UpdateSourceTrigger=PropertyChanged}" 
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      ToolTip="اعمال تقسیم بر ۱.۱ روی قیمت پس از تخفیف"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- درصد سود (الزامی حتی اگر صفر باشد) -->
                                                <DataGridTemplateColumn x:Name="ColProfitPercent" Header="سود % *" Width="0.75*" MinWidth="65">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="2" Cursor="IBeam">
                                                                <TextBlock Text="{Binding ProfitPercent, Converter={StaticResource NullablePercentDisplayConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ui:TextBox Text="{Binding ProfitPercent, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullablePercentConverter}}" PlaceholderText="الزامی" TextAlignment="Center" Height="38" Padding="4" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- مبلغ سود واحد -->
                                                <DataGridTemplateColumn x:Name="ColProfitAmount" Header="سود واحد (ریال)" Width="1.1*" MinWidth="95">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="2" Cursor="IBeam">
                                                                <TextBlock Text="{Binding ProfitAmount, StringFormat={}{0:N0}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ui:TextBox Text="{Binding ProfitAmount, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalNumberConverter}}" TextAlignment="Center" Height="38" Padding="4" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- سود کل سطر -->
                                                <DataGridTemplateColumn x:Name="ColTotalProfit" Header="سود کل سطر" Width="1.2*" MinWidth="105">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding TotalProfit, StringFormat={}{0:N0}}" 
                                                                       Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- قیمت نهایی فروش (خروجی مشتری) -->
                                                <DataGridTemplateColumn Header="قیمت فروش نهایی *" Width="1.3*" MinWidth="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="2" Cursor="IBeam">
                                                                <TextBlock Text="{Binding FinalUnitPrice, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ui:TextBox Text="{Binding FinalUnitPrice, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalNumberConverter}}" FontWeight="Bold" TextAlignment="Center" Height="38" Padding="4" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- مبلغ کل سطر -->
                                                <DataGridTemplateColumn Header="مبلغ کل سطر (ریال)" Width="1.3*" MinWidth="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:N0}}" 
                                                                       Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" 
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <!-- عملیات سطر (کپی و حذف) -->
                                                <DataGridTemplateColumn Header="عملیات" Width="1.0*" MinWidth="85">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <ui:Button Style="{StaticResource TableActionButton}" Margin="2,0" ToolTip="کپی کردن این سطر" Click="BtnDuplicateItem_Click">
                                                                    <ui:SymbolIcon Symbol="Copy20" FontSize="13" Foreground="{StaticResource PrimaryBrush}"/>
                                                                </ui:Button>
                                                                <ui:Button Style="{StaticResource SoftDangerButton}" Margin="2,0" ToolTip="حذف این سطر" Click="BtnRemoveItem_Click">
                                                                    <ui:SymbolIcon Symbol="Delete20" FontSize="13"/>
                                                                </ui:Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <!-- کارت‌های خلاصه مالی -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- جمع ناخالص -->
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="مجموع قیمت خام ناخالص:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtSummaryRawTotal" Text="0 ریال" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- مجموع تخفیف‌ها -->
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="مجموع تخفیف‌های اعطا شده:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtSummaryDiscountTotal" Text="0 ریال" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- مجموع سود پیش‌فاکتور (سود ما) -->
                                    <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="مجموع سود پیش‌فاکتور:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                                <Border Grid.Column="1" Background="{StaticResource SuccessLightBrush}" CornerRadius="4" Padding="5,1">
                                                    <TextBlock x:Name="TxtSummaryProfitPercent" Text="سود ما" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="TxtSummaryProfitTotal" Text="0 ریال" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- جمع نهایی فاکتور: کارت برجسته مدیریتی آبی کبالت -->
                                    <Border Grid.Column="3" Background="{StaticResource SurfaceCardBrush}" CornerRadius="10" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" Padding="14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="جمع نهایی قابل پرداخت:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <Border Grid.Column="1" Background="{StaticResource PrimaryLightBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock x:Name="TxtSummaryVatRateBadge" Text="+ ۱۰٪ ارزش افزوده" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="TxtSummaryGrandTotalWithVat" Text="0 ریال" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2"/>
                                            <TextBlock x:Name="TxtSummaryGrandTotalWords" Text="صفر ریال" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                            <TextBlock x:Name="TxtSummarySubtotalHint" Text="جمع اقلام: 0 ریال | ارزش افزوده: 0 ریال" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtSummaryGrandTotal" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- تنظیمات شرایط تسویه، تحویل، ارزش افزوده و هایلایت‌های اختصاصی این پیش‌فاکتور -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="شرایط تسویه، زمان و محل تحویل، ارزش افزوده و هایلایت‌های پیش‌فاکتور" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="این مقادیر مختص این پیش‌فاکتور تنظیم می‌شوند. با تیک زدن هر هایلایت، آن بند با رنگ زرد در فاکتور رسمی چاپ و اکسل برجسته خواهد شد." 
                                                           FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- ردیف ۴ فیلد: نوع تسویه، زمان تحویل، محل تحویل، درصد ارزش افزوده -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ۱. نوع تسویه -->
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="نوع تسویه:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                                <ui:TextBox x:Name="TxtEditorPaymentTerms" Text="نقد" Margin="0,0,0,4"/>
                                                <CheckBox x:Name="ChkHighlightPaymentTerms" Content="هایلایت زرد نوع تسویه" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand"/>
                                            </StackPanel>

                                            <!-- ۲. زمان تحویل -->
                                            <StackPanel Grid.Column="1" Margin="3,0,6,0">
                                                <TextBlock Text="زمان تحویل:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                                <ui:TextBox x:Name="TxtEditorDeliveryDays" Text="موجود" Margin="0,0,0,4"/>
                                                <CheckBox x:Name="ChkHighlightDeliveryDays" IsChecked="True" Content="هایلایت زرد زمان تحویل" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand"/>
                                            </StackPanel>

                                            <!-- ۳. محل تحویل -->
                                            <StackPanel Grid.Column="2" Margin="3,0,6,0">
                                                <TextBlock Text="محل تحویل کالا:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                                <ui:TextBox x:Name="TxtEditorDeliveryLocation" Text="مشهد" Margin="0,0,0,4"/>
                                                <CheckBox x:Name="ChkHighlightDeliveryLocation" Content="هایلایت زرد محل تحویل" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand"/>
                                            </StackPanel>

                                            <!-- ۴. درصد ارزش افزوده -->
                                            <StackPanel Grid.Column="3" Margin="3,0,0,0">
                                                <TextBlock Text="درصد ارزش افزوده (%):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                                <ui:TextBox x:Name="TxtEditorVatPercent" Text="10" TextAlignment="Center" Margin="0,0,0,4" TextChanged="TxtEditorVatPercent_TextChanged"/>
                                                <CheckBox x:Name="ChkHighlightVat" Content="هایلایت زرد ارزش افزوده" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- متن مهلت اعتبار و هایلایت آن -->
                                        <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="متن اعتبار پیش‌فاکتور:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtEditorValidityText" Text="اعتبار این پیش فاکتورتا پایان روز می باشد."/>
                                                </StackPanel>
                                                <CheckBox x:Name="ChkHighlightValidity" Grid.Column="1" VerticalAlignment="Center" IsChecked="True" Content="هایلایت زرد اعتبار (مشابه نمونه)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Cursor="Hand"/>
                                            </Grid>
                                        </Border>

                                        <!-- مسئول امضا و کارشناس خرید/فروش -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="نام امضاکننده پیش‌فاکتور (زیر مهر):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                <ui:TextBox x:Name="TxtEditorSignatoryName" Text="محمد احمدی پور هدش"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="عنوان کارشناس (سمت چپ پایین فاکتور):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                <ui:TextBox x:Name="TxtEditorExpertRole" Text="کارشناسی خرید:"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- توضیحات و هایلایت توضیحات -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="شرایط و توضیحات تکمیلی پیش‌فاکتور:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <CheckBox x:Name="ChkHighlightNotes" Grid.Column="1" IsChecked="True" Content="هایلایت زرد توضیحات در فاکتور رسمی" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Cursor="Hand"/>
                                        </Grid>
                                        <ui:TextBox x:Name="TxtEditorNotes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" Height="75" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- حساب‌های بانکی واریز این پیش‌فاکتور (پشتیبانی از چندین ردیف شماره حساب، شبا و کارت) -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="حساب‌های بانکی درج‌شونده در این پیش‌فاکتور:" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="می‌توانید برای این پیش‌فاکتور چندین ردیف حساب بانکی (شامل شماره حساب، شبا و شماره کارت) اضافه یا حذف نمایید:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ui:Button Grid.Column="1" Appearance="Secondary" Content="بارگذاری از تنظیمات اصلی" Click="BtnResetEditorBankAccounts_Click" ToolTip="بازنشانی حساب‌های این فاکتور به حساب‌های پیش‌فرض تنظیمات"/>
                                        </Grid>

                                        <DataGrid x:Name="DgrEditorBankAccounts" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                                                  MinHeight="75" MaxHeight="160" Margin="0,0,0,8">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="بانک" Binding="{Binding BankName}" Width="1.1*" MinWidth="80" FontWeight="Bold"/>
                                                <DataGridTextColumn Header="شماره حساب" Binding="{Binding AccountNumber}" Width="1.3*" MinWidth="95"/>
                                                <DataGridTextColumn Header="شماره شبا (IR...)" Binding="{Binding ShebaNumber}" Width="1.8*" MinWidth="130"/>
                                                <DataGridTextColumn Header="شماره کارت" Binding="{Binding CardNumber}" Width="1.4*" MinWidth="105"/>
                                                <DataGridTextColumn Header="صاحب حساب" Binding="{Binding OwnerName}" Width="1.4*" MinWidth="95"/>
                                                <DataGridTemplateColumn Header="عملیات" Width="0.8*" MinWidth="60">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ui:Button Style="{StaticResource SoftDangerButton}" ToolTip="حذف این حساب از این پیش‌فاکتور" Click="BtnDeleteEditorBankAccount_Click" HorizontalAlignment="Center">
                                                                <ui:SymbolIcon Symbol="Delete20" FontSize="13"/>
                                                            </ui:Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- فرم افزودن سریع حساب بانکی جدید برای این فاکتور -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.6*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="نام بانک:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                <ui:TextBox x:Name="TxtEditorNewBankName" PlaceholderText="بانک ملی..." Height="32"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="2,0,4,0">
                                                <TextBlock Text="شماره حساب:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                <ui:TextBox x:Name="TxtEditorNewBankAccountNumber" PlaceholderText="شماره حساب..." Height="32"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="2,0,4,0">
                                                <TextBlock Text="شماره شبا:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                <ui:TextBox x:Name="TxtEditorNewBankSheba" PlaceholderText="IR..." Height="32"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Margin="2,0,4,0">
                                                <TextBlock Text="شماره کارت:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                <ui:TextBox x:Name="TxtEditorNewBankCard" PlaceholderText="۱۶ رقمی..." Height="32"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" Margin="2,0,4,0">
                                                <TextBlock Text="صاحب حساب:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                <ui:TextBox x:Name="TxtEditorNewBankOwner" PlaceholderText="نام شرکت..." Height="32"/>
                                            </StackPanel>

                                            <ui:Button Grid.Column="5" Appearance="Primary" Height="32" VerticalAlignment="Bottom" Padding="10,0" Click="BtnAddEditorBankAccount_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Add20" Margin="0,0,3,0"/>
                                                    <TextBlock Text="افزودن حساب" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- دکمه‌های اقدام -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,24">
                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <!-- دکمه ذخیره پیش‌فاکتور -->
                                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" 
                                                       Content="ذخیره پیش‌فاکتور" Padding="20,10" FontSize="13" FontWeight="Bold" Margin="0,0,8,0" Click="BtnSaveInvoice_Click"/>

                                            <!-- دکمه تأیید پیش‌فاکتور و چاپ مستقیم -->
                                            <ui:Button Appearance="Success" Padding="16,10" FontSize="12.5" FontWeight="Bold" Margin="0,0,8,0" Click="BtnApproveAndPrint_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="White" Margin="0,0,6,0"/>
                                                    <TextBlock Text="تأیید و چاپ مستقیم" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:Button>

                                            <!-- اقدامات ثانویه با آیکون‌های تمیز و بدون اغتشاش رنگی -->
                                            <ui:Button Appearance="Secondary" Padding="14,10" FontSize="12.5" Margin="0,0,8,0" Click="BtnSaveAndExportExcel_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="DocumentTable24" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="ذخیره و صدور اکسل" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:Button>

                                            <!-- دکمه ذخیره PDF مستقیم -->
                                            <ui:Button Appearance="Secondary" Padding="14,10" FontSize="12.5" Margin="0,0,8,0" Click="BtnSaveAndExportPdf_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="DocumentPdf24" Foreground="{StaticResource DangerBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="ذخیره PDF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:Button>

                                            <ui:Button Appearance="Secondary" Padding="14,10" FontSize="12.5" Margin="0,0,8,0" Click="BtnSaveAndPrintPdf_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Print24" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="ذخیره و چاپ" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:Button>

                                            <ui:Button Appearance="Secondary" Content="انصراف و بازگشت" Padding="14,10" FontSize="12.5" Click="BtnCancelEditor_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ۳. صفحه انبار و محصولات -->
                    <Grid x:Name="ViewStorage" Margin="24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- کارت‌های شاخص انبار و نوار جستجو -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- کارت‌های KPI انبار -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="تعداد کل اقلام در انبار" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtStorageKpiTotalCount" Text="0 قلم کالا" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="دسته‌بندی‌های فعال" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtStorageKpiCategories" Text="ابزار دقیق، صنعتی، عمومی" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- جستجو و دکمه‌های انبار -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox x:Name="TxtSearchStorage" Grid.Column="0" Margin="0,0,10,0"
                                                PlaceholderText="جستجو در کد، نام کالا یا دسته‌بندی انبار..."
                                                Icon="{ui:SymbolIcon Symbol=Search24}" ClearButtonEnabled="True"
                                                TextChanged="TxtSearchStorage_TextChanged"/>

                                    <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=DocumentTable24}"
                                               Content="خروجی اکسل انبار" Margin="0,0,8,0" Click="BtnExportStorageExcel_Click"/>

                                    <ui:Button Grid.Column="2" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add24}"
                                               Content="تعریف کالای جدید" Click="BtnNewStorageItem_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- جدول اقلام انبار و فرم ویرایش -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.3*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- جدول کالاها -->
                            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,14,0" ClipToBounds="True">
                                <DataGrid x:Name="DgrStorage" AutoGenerateColumns="False" SelectionMode="Single"
                                          CanUserResizeColumns="True" CanUserSortColumns="True"
                                          MouseDoubleClick="DgrStorage_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="کد کالا" Binding="{Binding Code}" Width="0.8*" MinWidth="75"/>
                                        <DataGridTemplateColumn Header="نام کالا / شرح قطعه" Width="2.8*" MinWidth="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="6,4" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="واحد" Binding="{Binding Unit}" Width="0.7*" MinWidth="50"/>
                                        <DataGridTextColumn Header="قیمت خام پیش‌فرض" Binding="{Binding DefaultPrice, StringFormat={}{0:N0}}" Width="1.3*" MinWidth="110"/>
                                        <DataGridTextColumn Header="دسته‌بندی" Binding="{Binding Category}" Width="1.2*" MinWidth="100"/>
                                        <DataGridTemplateColumn Header="عملیات" Width="0.9*" MinWidth="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ui:Button Style="{StaticResource TableActionButton}" Margin="2,0" ToolTip="ویرایش کالا" Click="BtnEditStorageItem_Click">
                                                            <ui:SymbolIcon Symbol="Edit20" Foreground="{StaticResource PrimaryBrush}" FontSize="13"/>
                                                        </ui:Button>
                                                        <ui:Button Style="{StaticResource SoftDangerButton}" Margin="2,0" ToolTip="حذف کالا" Click="BtnDeleteStorageItem_Click">
                                                            <ui:SymbolIcon Symbol="Delete20" FontSize="13"/>
                                                        </ui:Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- فرم ثبت و ویرایش کالا -->
                            <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtStorageFormTitle" Text="مشخصات کالای انبار" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                                        <TextBlock Text="کد کالا:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <ui:TextBox x:Name="TxtStorageCode" PlaceholderText="PRD-101" Margin="0,0,0,8"/>

                                        <TextBlock Text="نام کالا یا قطعه *:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <ui:TextBox x:Name="TxtStorageName" PlaceholderText="نام کامل کالا را وارد کنید..." TextWrapping="Wrap" Height="50" Margin="0,0,0,8"/>

                                        <TextBlock Text="واحد کالا:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <ComboBox x:Name="CmbStorageUnit" Height="36" HorizontalAlignment="Stretch" IsEditable="True" Margin="0,0,0,8"/>

                                        <TextBlock Text="قیمت خام پایه (ریال):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <ui:TextBox x:Name="TxtStoragePrice" Text="0" Margin="0,0,0,8"/>

                                        <TextBlock Text="دسته‌بندی / گروه:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <ui:TextBox x:Name="TxtStorageCategory" PlaceholderText="مثلاً: ابزار دقیق، قطعات برق..." Margin="0,0,0,8"/>

                                        <TextBlock Text="توضیحات تکمیلی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <ui:TextBox x:Name="TxtStorageDesc" TextWrapping="Wrap" Height="55" Margin="0,0,0,14"/>

                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" Content="ذخیره کالا" Click="BtnSaveStorageItem_Click" Margin="0,0,8,0"/>
                                            <ui:Button Appearance="Secondary" Content="انصراف" Click="BtnClearStorageForm_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ۴. صفحه گزارشات جامع -->
                    <Grid x:Name="ViewReports" Margin="24" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- نوار فیلترهای پیشرفته گزارش -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="فیلترهای جامع گزارش‌گیری" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- فیلتر ماه -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="فیلتر ماه صدور:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="CmbReportMonth" Height="36" HorizontalAlignment="Stretch" SelectionChanged="ReportFilter_Changed"/>
                                    </StackPanel>

                                    <!-- فیلتر سال -->
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="سال صدور:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="CmbReportYear" Height="36" HorizontalAlignment="Stretch" SelectionChanged="ReportFilter_Changed"/>
                                    </StackPanel>

                                    <!-- فیلتر کارشناس -->
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="کارشناس صادرکننده:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="CmbReportExpert" Height="36" HorizontalAlignment="Stretch" SelectionChanged="ReportFilter_Changed"/>
                                    </StackPanel>

                                    <!-- فیلتر شرکت -->
                                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                        <TextBlock Text="شرکت (مشتری):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="CmbReportCompany" Height="36" HorizontalAlignment="Stretch" SelectionChanged="ReportFilter_Changed"/>
                                    </StackPanel>

                                    <!-- فیلتر وضعیت -->
                                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                        <TextBlock Text="وضعیت فاکتور:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="CmbReportStatus" Height="36" HorizontalAlignment="Stretch" SelectionChanged="ReportFilter_Changed"/>
                                    </StackPanel>

                                    <!-- دکمه‌های گزارش -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowReset24}" ToolTip="ریست فیلترها" Click="BtnResetReportFilter_Click" Margin="0,0,6,0"/>
                                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=DocumentTable24}" Content="خروجی اکسل" Click="BtnExportReportExcel_Click" Margin="0,0,6,0"/>
                                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Print24}" Content="چاپ گزارش" Click="BtnPrintReport_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- کارت‌های خلاصه KPI گزارش -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="تعداد پیش‌فاکتورها" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtReportKpiCount" Text="0 عدد" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TxtReportKpiCountHint" Text="بر اساس فیلتر فعال" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="مجموع مبلغ پیش‌فاکتورها" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtReportKpiTotalAmount" Text="0 ریال" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="جمع ناخالص کل" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="مجموع سود خالص حاصله" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                                    <TextBlock x:Name="TxtReportKpiTotalProfit" Text="0 ریال" FontSize="17" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TxtReportKpiProfitMargin" Text="میانگین حاشیه سود: 0%" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="تفکیک وضعیت‌های مالی" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtReportKpiPaidAmount" Text="واریز شده: 0" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TxtReportKpiUnpaidAmount" Text="واریز نشده: 0" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- جدول پیش‌فاکتورهای گزارش -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                            <DataGrid x:Name="DgrReports" AutoGenerateColumns="False" SelectionMode="Single"
                                      CanUserResizeColumns="True" CanUserSortColumns="True"
                                      MouseDoubleClick="DgrReports_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="شماره فاکتور" Binding="{Binding InvoiceNumber}" Width="1.2*" MinWidth="110"/>
                                    <DataGridTextColumn Header="تاریخ صدور" Binding="{Binding IssueDateShamsi}" Width="0.9*" MinWidth="85"/>
                                    <DataGridTextColumn Header="نام مشتری / شرکت" Binding="{Binding CompanyName}" Width="2.2*" MinWidth="160"/>
                                    <DataGridTextColumn Header="کارشناس" Binding="{Binding ExpertName}" Width="1.3*" MinWidth="110"/>
                                    <DataGridTextColumn Header="مبلغ کل (ریال)" Binding="{Binding GrandTotal, StringFormat={}{0:N0}}" Width="1.4*" MinWidth="110"/>
                                    <DataGridTextColumn Header="سود ناخالص" Binding="{Binding TotalProfit, StringFormat={}{0:N0}}" Width="1.3*" MinWidth="105"/>
                                    <DataGridTemplateColumn Header="وضعیت" Width="1.1*" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{Binding Status, Converter={StaticResource StatusToBgColorBrushConverter}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToStringConverter}}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToColorBrushConverter}}"
                                                               FontWeight="Bold" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="اقدام" Width="1.2*" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <ui:Button Style="{StaticResource TableActionButton}" Margin="2,0" ToolTip="چاپ مستقیم فاکتور" Click="BtnPrintPdf_Click">
                                                        <ui:SymbolIcon Symbol="Print20" Foreground="{StaticResource PrimaryBrush}" FontSize="13"/>
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource TableActionButton}" Margin="2,0" ToolTip="ویرایش فاکتور" Click="MenuItem_Edit_Click">
                                                        <ui:SymbolIcon Symbol="Edit20" Foreground="{StaticResource PrimaryBrush}" FontSize="13"/>
                                                    </ui:Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- ۳. صفحه شرکت‌ها -->
                    <Grid x:Name="ViewCompanies" Margin="24" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,16,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="فهرست شرکت‌های خریدار (مشتریان)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add24}" Content="شرکت جدید" Click="BtnNewCompany_Click"/>
                                </Grid>

                                <DataGrid x:Name="DgrCompanies" Grid.Row="1" AutoGenerateColumns="False" 
                                          PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp"
                                          SelectionChanged="DgrCompanies_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="نوع" Binding="{Binding CompanyTypeTitle}" Width="1.1*" MinWidth="80"/>
                                        <DataGridTextColumn Header="نام طرف حساب / شرکت" Binding="{Binding Name}" Width="2.3*" MinWidth="140" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="کد اقتصادی / شناسه ملی" Binding="{Binding NationalOrEconomicCode}" Width="1.5*" MinWidth="120"/>
                                        <DataGridTextColumn Header="شماره ثبت" Binding="{Binding RegistrationNo}" Width="1.0*" MinWidth="85"/>
                                        <DataGridTextColumn Header="تلفن" Binding="{Binding Phone}" Width="1.2*" MinWidth="95"/>
                                        
                                        <DataGridTemplateColumn Header="عملیات" Width="1.4*" MinWidth="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ui:Button Style="{StaticResource TableActionButton}" Margin="3,0" ToolTip="ویرایش شرکت" Click="BtnEditCompany_Click">
                                                            <ui:SymbolIcon Symbol="Edit20" FontSize="14" Foreground="#2563EB"/>
                                                        </ui:Button>
                                                        <ui:Button Style="{StaticResource SoftDangerButton}" Margin="3,0" ToolTip="حذف شرکت" Click="BtnDeleteCompany_Click">
                                                            <ui:SymbolIcon Symbol="Delete20" FontSize="14"/>
                                                        </ui:Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- فرم ثبت شرکت -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock x:Name="TxtCompanyFormTitle" Text="ثبت طرف حساب (حقوقی یا حقیقی) جدید" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.8*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="نوع طرف حساب:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CmbCompanyType" Height="36" HorizontalAlignment="Stretch" SelectionChanged="CmbCompanyType_SelectionChanged">
                                            <ComboBoxItem Content="حقوقی (شرکت/سازمان)" IsSelected="True"/>
                                            <ComboBoxItem Content="حقیقی (شخص)"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock x:Name="LblCompanyFormName" Text="نام شرکت یا شخص طرف حساب *:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <ui:TextBox x:Name="TxtCompanyName"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock x:Name="LblCompanyCode" Text="شناسه ملی / کد اقتصادی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <ui:TextBox x:Name="TxtCompanyEconomicCode"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock x:Name="LblCompanyReg" Text="شماره ثبت شرکت:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <ui:TextBox x:Name="TxtCompanyRegistrationNo"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="تلفن ثابت تماس:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <ui:TextBox x:Name="TxtCompanyPhone"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="تلفن همراه / رابط:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <ui:TextBox x:Name="TxtCompanyMobile"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="نشانی کامل:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtCompanyAddress" Margin="0,0,0,10"/>

                                <TextBlock Text="توضیحات:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtCompanyDescription" AcceptsReturn="True" Height="60" Margin="0,0,0,16"/>

                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" Content="ذخیره طرف حساب" Click="BtnSaveCompany_Click" Margin="0,0,8,0"/>
                                    <ui:Button Appearance="Secondary" Content="انصراف" Click="BtnClearCompanyForm_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ۴. صفحه کارشناسان -->
                    <Grid x:Name="ViewExperts" Margin="24" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,16,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="فهرست کارشناسان فروش با شماره‌انداز مستقل" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add24}" Content="کارشناس جدید" Click="BtnNewExpert_Click"/>
                                </Grid>

                                <DataGrid x:Name="DgrExperts" Grid.Row="1" AutoGenerateColumns="False" 
                                          PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp"
                                          SelectionChanged="DgrExperts_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="نام کارشناس" Binding="{Binding FullName}" Width="1.5*" MinWidth="110" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="سمت" Binding="{Binding RoleTitle}" Width="1.1*" MinWidth="90"/>
                                        <DataGridTextColumn Header="شرکت‌های مجاز" Binding="{Binding AssignedCompaniesDisplay}" Width="1.6*" MinWidth="120"/>
                                        <DataGridTextColumn Header="پیشوند فاکتور" Binding="{Binding InvoicePrefix}" Width="1.0*" MinWidth="85"/>
                                        <DataGridTextColumn Header="شماره بعدی" Binding="{Binding NextInvoiceNumber}" Width="1.0*" MinWidth="85" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="تلفن" Binding="{Binding PhoneNumber}" Width="1.1*" MinWidth="95"/>

                                        <DataGridTemplateColumn Header="عملیات" Width="1.2*" MinWidth="95">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ui:Button Style="{StaticResource TableActionButton}" Margin="3,0" ToolTip="ویرایش کارشناس" Click="BtnEditExpert_Click">
                                                            <ui:SymbolIcon Symbol="Edit20" FontSize="14" Foreground="#2563EB"/>
                                                        </ui:Button>
                                                        <ui:Button Style="{StaticResource SoftDangerButton}" Margin="3,0" ToolTip="حذف کارشناس" Click="BtnDeleteExpert_Click">
                                                            <ui:SymbolIcon Symbol="Delete20" FontSize="14"/>
                                                        </ui:Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- فرم کارشناس -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock x:Name="TxtExpertFormTitle" Text="ثبت کارشناس جدید" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                                <TextBlock Text="نام و نام خانوادگی کارشناس *:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtExpertFullName" Margin="0,0,0,10"/>

                                <TextBlock Text="سمت / عنوان شغلی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtExpertRole" Text="کارشناس فروش" Margin="0,0,0,10"/>

                                <!-- انتساب کارشناس به شرکت‌ها -->
                                <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="انتساب به شرکت‌ها (مشتریان اختصاصی/مشترک):" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkExpertAllCompanies" Content="کارشناس عمومی (مجاز برای تمام شرکت‌ها)" IsChecked="True" Margin="0,0,0,6" Checked="ChkExpertAllCompanies_Changed" Unchecked="ChkExpertAllCompanies_Changed"/>
                                        <TextBlock Text="یا انتخاب یک یا چند شرکت اختصاصی:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                        <Border BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}" Background="White" CornerRadius="6">
                                            <ListBox x:Name="LstExpertCompanies" MaxHeight="110" SelectionMode="Multiple" DisplayMemberPath="Name" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- کادر شماره‌گذاری مستقل -->
                                <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="تنظیمات شماره‌گذاری اختصاصی پیش‌فاکتور:" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                        
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="پیشوند فاکتور:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ui:TextBox x:Name="TxtExpertPrefix" Text="EXP-" TextChanged="TxtExpertNumbering_TextChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="شمارنده بعدی:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ui:TextBox x:Name="TxtExpertNextNum" Text="1001" TextChanged="TxtExpertNumbering_TextChanged"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock x:Name="TxtExpertNumberPreview" Text="پیش‌نمایش: EXP-1001" 
                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="تلفن همراه:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <ui:TextBox x:Name="TxtExpertPhone"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="ایمیل:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <ui:TextBox x:Name="TxtExpertEmail"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" Content="ذخیره کارشناس" Click="BtnSaveExpert_Click" Margin="0,0,8,0"/>
                                    <ui:Button Appearance="Secondary" Content="انصراف" Click="BtnClearExpertForm_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ۵. صفحه تنظیمات و ظاهر پیش‌فاکتور -->
                    <Grid x:Name="ViewSettings" Margin="24" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ستون ۱ (راست): تنظیمات تصویر لوگو، قلم‌ها، سربرگ و اطلاعات بانکی -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,14" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="تنظیمات تصویر شرکت، قلم‌ها و سربرگ پیش‌فاکتور" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="انتخاب لوگوی شرکت، مهر و امضا، سفارشی‌سازی قلم نام شرکت و سطرها و اطلاعات بانکی." 
                                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                                            <!-- انتخاب تصویر لوگوی شرکت -->
                                            <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="55" Height="55" CornerRadius="6" Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True">
                                                        <Image x:Name="ImgLogoPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="تصویر لوگوی شرکت (بالای سربرگ):" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                                        <ui:TextBox x:Name="TxtCompanyLogoPath" PlaceholderText="مسیر فایل لوگو (.png, .jpg)..." IsReadOnly="True"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Content="انتخاب..." Click="BtnBrowseLogo_Click" Margin="0,0,4,0"/>
                                                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Dismiss24}" ToolTip="حذف لوگو" Click="BtnClearLogo_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- تصویر مهر و امضای شرکت -->
                                            <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="70" Height="55" CornerRadius="6" Background="White" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True">
                                                        <Image x:Name="ImgStampPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="تصویر مهر و امضای رسمی شرکت:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                                        <ui:TextBox x:Name="TxtCompanyStampPath" PlaceholderText="مسیر تصویر مهر (.png, .jpg)..." IsReadOnly="True"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                                        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Content="انتخاب..." Click="BtnBrowseStamp_Click" Margin="0,0,4,0"/>
                                                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Dismiss24}" ToolTip="حذف مهر" Click="BtnClearStamp_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- تنظیمات فونت‌ها -->
                                            <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="تنظیم قلم نام شرکت و سطرها:" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                                    
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                            <TextBlock Text="فونت نام شرکت:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox x:Name="CmbFontCompanyName" Height="36" HorizontalAlignment="Stretch" IsEditable="True" IsTextSearchEnabled="True">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="12.5"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Margin="2,0,6,0">
                                                            <TextBlock Text="اندازه نام:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                            <ui:TextBox x:Name="TxtFontSizeCompanyName" Text="18" TextAlignment="Center" Height="36"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Margin="2,0,6,0">
                                                            <TextBlock Text="فونت سطرها:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                            <ComboBox x:Name="CmbFontTable" Height="36" HorizontalAlignment="Stretch" IsEditable="True" IsTextSearchEnabled="True">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="12.5"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Margin="2,0,0,0">
                                                            <TextBlock Text="اندازه سطر:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                            <ui:TextBox x:Name="TxtFontSizeTable" Text="11" TextAlignment="Center" Height="36"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- اطلاعات یکپارچه حساب‌های بانکی و شرایط تسویه -->
                                            <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="اطلاعات حساب‌های بانکی و شرایط تسویه:" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="حساب‌های بانکی جهت درج در فاکتور (شماره شبا و کارت) به همراه شرایط پیش‌فرض تسویه و تحویل:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                                                    
                                                    <DataGrid x:Name="DgrBankAccounts" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                                                              MinHeight="90" MaxHeight="180" Margin="0,0,0,8">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="بانک" Binding="{Binding BankName}" Width="1.1*" MinWidth="80" FontWeight="Bold"/>
                                                            <DataGridTextColumn Header="شماره حساب" Binding="{Binding AccountNumber}" Width="1.3*" MinWidth="95"/>
                                                            <DataGridTextColumn Header="شماره شبا (IR...)" Binding="{Binding ShebaNumber}" Width="1.8*" MinWidth="130"/>
                                                            <DataGridTextColumn Header="شماره کارت" Binding="{Binding CardNumber}" Width="1.4*" MinWidth="105"/>
                                                            <DataGridTextColumn Header="صاحب حساب" Binding="{Binding OwnerName}" Width="1.4*" MinWidth="95"/>
                                                            <DataGridTemplateColumn Header="عملیات" Width="0.8*" MinWidth="60">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <ui:Button Style="{StaticResource SoftDangerButton}" ToolTip="حذف این حساب" Click="BtnDeleteBankAccount_Click" HorizontalAlignment="Center">
                                                                            <ui:SymbolIcon Symbol="Delete20" FontSize="13"/>
                                                                        </ui:Button>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                        </DataGrid.Columns>
                                                    </DataGrid>

                                                    <!-- فرم افزودن حساب بانکی جدید -->
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.1*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.6*"/>
                                                            <ColumnDefinition Width="1.3*"/>
                                                            <ColumnDefinition Width="1.3*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                            <TextBlock Text="نام بانک:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                            <ui:TextBox x:Name="TxtNewBankName" PlaceholderText="بانک ملی..." Height="32"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Margin="2,0,4,0">
                                                            <TextBlock Text="شماره حساب:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                            <ui:TextBox x:Name="TxtNewBankAccountNumber" PlaceholderText="شماره حساب..." Height="32"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Margin="2,0,4,0">
                                                            <TextBlock Text="شماره شبا:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                            <ui:TextBox x:Name="TxtNewBankSheba" PlaceholderText="IR..." Height="32"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Margin="2,0,4,0">
                                                            <TextBlock Text="شماره کارت:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                            <ui:TextBox x:Name="TxtNewBankCard" PlaceholderText="۱۶ رقمی..." Height="32"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="4" Margin="2,0,4,0">
                                                            <TextBlock Text="صاحب حساب:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                            <ui:TextBox x:Name="TxtNewBankOwner" PlaceholderText="نام شرکت..." Height="32"/>
                                                        </StackPanel>

                                                        <ui:Button Grid.Column="5" Appearance="Primary" Height="32" VerticalAlignment="Bottom" Padding="10,0" Click="BtnAddBankAccount_Click">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="Add20" Margin="0,0,3,0"/>
                                                                <TextBlock Text="افزودن حساب" FontSize="11" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </ui:Button>
                                                    </Grid>

                                                    <!-- جداکننده ظریف -->
                                                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,4,0,10"/>

                                                    <!-- شرایط تسویه، تحویل و ارزش افزوده -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                                            <TextBlock Text="نوع تسویه پیش‌فرض:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                            <ui:TextBox x:Name="TxtPaymentTerms" Text="نقد"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                                            <TextBlock Text="زمان تحویل پیش‌فرض:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                            <ui:TextBox x:Name="TxtDeliveryDays" Text="سه روز کاری"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                                            <TextBlock Text="محل تحویل پیش‌فرض:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                            <ui:TextBox x:Name="TxtDeliveryLocation" Text="مشهد"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                            <TextBlock Text="نام مسئول امضا (زیر مهر):" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                            <ui:TextBox x:Name="TxtSignatoryName" Text="محمد احمدی پور هدش"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                            <TextBlock Text="عنوان کارشناس (پایین فاکتور):" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                            <ui:TextBox x:Name="TxtExpertRoleLabel" Text="کارشناسی خرید:"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                            <TextBlock Text="متن پیش‌فرض اعتبار پیش‌فاکتور:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                            <ui:TextBox x:Name="TxtDefaultValidityText" Text="اعتبار این پیش فاکتورتا پایان روز می باشد."/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                            <TextBlock Text="واحد پول پیش‌فرض:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                            <ComboBox x:Name="CmbSettingsCurrencyUnit" Height="36" HorizontalAlignment="Stretch" IsEnabled="False">
                                                                <ComboBoxItem Content="ریال" IsSelected="True"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                            <TextBlock Text="درصد ارزش افزوده (%):" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                            <ui:TextBox x:Name="TxtVatPercent" Text="10" TextAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" Content="ذخیره تنظیمات ظاهر و سربرگ" Click="BtnSaveInvoiceAppearance_Click" Margin="0,0,8,0"/>
                                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=Print24}" Content="پیش‌نمایش چاپ" Click="BtnTestPrintSample_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- کارت قالب استاندارد مصوب -->
                                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="قالب استاندارد و رسمی مصوب سیستم" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="خروجی پیش‌فاکتورها به صورت رسمی، بر اساس طرح استاندارد مصوب شرکت (شامل سربرگ، تصویر لوگو و مهر رسمی، نام اقلام کالا ۲ و ۳ خطی خودکار، ردیف‌های محاسباتی و جدول مشخصات واریزی) در هر دو بستر اکسل و پرینت مستقیم تولید می‌گردد." 
                                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ستون ۲ (چپ): مشخصات شرکت ما (فروشنده) و پشتیبان‌گیری -->
                                <StackPanel Grid.Column="1">
                                    <!-- مشخصات شرکت ما (فروشنده) -->
                                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,14" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="مشخصات شرکت ما (فروشنده)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                            <TextBlock Text="نام شرکت فروشنده:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                            <ui:TextBox x:Name="TxtSellerName" Margin="0,0,0,8"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="شماره ثبت:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtSellerRegistrationNo" Text="۸۸۶۵۴"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                    <TextBlock Text="شناسه ملی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtSellerNatCode"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                    <TextBlock Text="کد اقتصادی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtSellerEcoCode"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="تلفن تماس:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                            <ui:TextBox x:Name="TxtSellerPhone" Margin="0,0,0,8"/>

                                            <TextBlock Text="نشانی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                            <ui:TextBox x:Name="TxtSellerAddress" Margin="0,0,0,12"/>

                                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" Content="ذخیره مشخصات فروشنده" Click="BtnSaveSellerSettings_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- پشتیبان‌گیری از اطلاعات -->
                                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="پشتیبان‌گیری از اطلاعات" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <TextBlock Text="تهیه فایل پشتیبان از تمام فاکتورها، شرکت‌ها و کارشناسان." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>

                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" Content="تهیه پشتیبان (Backup)" Margin="0,0,8,0" Click="BtnBackup_Click"/>
                                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" Content="بازیابی (Restore)" Click="BtnRestore_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                </Grid>

                <!-- نوار وضعیت پایین -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="14" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtStatusMessage" Text="آماده به‌کار" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="توسعه داده شده توسط تیم نرم افزاری شرکت آریان نیرو گستر اترک" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text=" • " FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تـراز (نسخه بتا v0.2.0-beta)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
