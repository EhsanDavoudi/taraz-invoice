<ui:FluentWindow x:Class="TarazInvoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:TarazInvoice"
        mc:Ignorable="d"
        Title="تـراز (v0.1.0-pre-alpha) - سامانه جامع صدور و مدیریت پیش‌فاکتور"
        Height="880" Width="1400"
        MinHeight="740" MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        FlowDirection="LeftToRight"
        FontFamily="{StaticResource AppFontFamily}"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <!-- نوار عنوان استاندارد ویندوز ۱۱ با دکمه‌های [X] و [...] در بالا-راست -->
            <RowDefinition Height="Auto"/>
            <!-- محیط کاری اصلی برنامه -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- نوار عنوان فلوئنت ویندوز ۱۱ -->
        <ui:TitleBar Grid.Row="0" Title="تـراز | سامانه جامع صدور و مدیریت پیش‌فاکتور (v0.1.0-pre-alpha)" />

        <!-- ساختار اصلی برنامه با جهت کاملاً بومی راست‌چین فارسی -->
        <Grid Grid.Row="1" FlowDirection="RightToLeft">
            <Grid.ColumnDefinitions>
                <!-- سایدبار ناوبری (در حالت RTL در سمت راست پنجره قرار می‌گیرد) -->
                <ColumnDefinition Width="260"/>
                <!-- صفحه کاری محتوا (در حالت RTL در سمت چپ سایدبار قرار می‌گیرد) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== سایدبار ناوبری (TARAZ Sidebar) ==================== -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- برندینگ و لوگوی رسمی تراز -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,4,0,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- تصویر لوگوی رسمی تراز -->
                            <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,12,0" ClipToBounds="True">
                                <Image Source="/Resources/logo.png" Width="44" Height="44" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="تـراز" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="سامانه مدیریت پیش‌فاکتور" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- دکمه برجسته صدور پیش‌فاکتور جدید -->
                    <ui:Button Grid.Row="1" Appearance="Primary" Height="44" Margin="2,0,2,18" HorizontalAlignment="Stretch"
                               Icon="{ui:SymbolIcon Symbol=AddCircle24}" Content="صدور پیش‌فاکتور جدید" 
                               FontSize="13" FontWeight="Bold" Click="BtnNewInvoice_Click"/>

                    <!-- منوی ناوبری سایدبار با پشتیبانی از هایلایت فعال و تغییر ظاهر -->
                    <StackPanel Grid.Row="2" Margin="0,2">
                        <!-- فهرست پیش‌فاکتورها -->
                        <Border x:Name="NavCardInvoices" Tag="Invoices" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,3"
                                MouseEnter="NavCard_MouseEnter" MouseLeave="NavCard_MouseLeave">
                            <Button x:Name="NavBtnInvoices" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="44" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavBtn_Click" Tag="Invoices" 
                                    Cursor="Hand" Padding="14,0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="14,0">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="NavIconInvoices" Symbol="DocumentBulletList24" Margin="0,0,12,0" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="NavTextInvoices" Text="فهرست پیش‌فاکتورها" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- فرم ثبت / ویرایش فاکتور -->
                        <Border x:Name="NavCardEditor" Tag="Editor" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,3"
                                MouseEnter="NavCard_MouseEnter" MouseLeave="NavCard_MouseLeave">
                            <Button x:Name="NavBtnEditor" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="44" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavBtn_Click" Tag="Editor" 
                                    Cursor="Hand" Padding="14,0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="14,0">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="NavIconEditor" Symbol="Edit24" Margin="0,0,12,0" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="NavTextEditor" Text="فرم ثبت / ویرایش فاکتور" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- شرکت‌ها (طرف حساب) -->
                        <Border x:Name="NavCardCompanies" Tag="Companies" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,3"
                                MouseEnter="NavCard_MouseEnter" MouseLeave="NavCard_MouseLeave">
                            <Button x:Name="NavBtnCompanies" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="44" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavBtn_Click" Tag="Companies" 
                                    Cursor="Hand" Padding="14,0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="14,0">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="NavIconCompanies" Symbol="Building24" Margin="0,0,12,0" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="NavTextCompanies" Text="شرکت‌ها (طرف حساب)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- کارشناسان و شماره‌انداز -->
                        <Border x:Name="NavCardExperts" Tag="Experts" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,3"
                                MouseEnter="NavCard_MouseEnter" MouseLeave="NavCard_MouseLeave">
                            <Button x:Name="NavBtnExperts" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="44" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavBtn_Click" Tag="Experts" 
                                    Cursor="Hand" Padding="14,0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="14,0">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="NavIconExperts" Symbol="People24" Margin="0,0,12,0" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="NavTextExperts" Text="کارشناسان و شماره‌انداز" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- قالب اکسل و تنظیمات -->
                        <Border x:Name="NavCardSettings" Tag="Settings" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="0,3"
                                MouseEnter="NavCard_MouseEnter" MouseLeave="NavCard_MouseLeave">
                            <Button x:Name="NavBtnSettings" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="44" 
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NavBtn_Click" Tag="Settings" 
                                    Cursor="Hand" Padding="14,0" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Padding="14,0">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="NavIconSettings" Symbol="Settings24" Margin="0,0,12,0" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="NavTextSettings" Text="قالب اکسل و تنظیمات" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>

                    <!-- نشانگر وضعیت پایگاه داده محلی در انتهای سایدبار -->
                    <Border Grid.Row="3" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="پایگاه داده محلی فعال" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="داده‌ها ۱۰۰٪ آفلاین و محلی ذخیره می‌شوند" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== محیط کاری محتوا (راست‌چین فارسی) ==================== -->
            <Grid Grid.Column="1" Background="{StaticResource CanvasBackgroundBrush}">
                <Grid.RowDefinitions>
                    <!-- هدر صفحه با عنوان و تاریخ -->
                    <RowDefinition Height="64"/>
                    <!-- محتوای تعاملی صفحه -->
                    <RowDefinition Height="*"/>
                    <!-- نوار وضعیت پایین -->
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- هدر صفحه -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- عنوان و توضیح خوانا -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPageTitle" Text="فهرست و کارتابل پیش‌فاکتورها" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtPageSubtitle" Text="رهگیری وضعیت فروش، خروجی تمیز اکسل برای مشتریان و چاپ مستقیم رسمی" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- تاریخ شمسی زیبا در سمت چپ هدر -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="CalendarLtr24" Margin="0,0,8,0" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock x:Name="TxtCurrentDate" Text="امروز: ۱۴۰۳/۰۶/۱۵" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== صفحات مختلف ==================== -->
                <Grid Grid.Row="1">

                    <!-- ۱. صفحه پیش‌فاکتورها (Dashboard & Table) -->
                    <Grid x:Name="ViewInvoices" Margin="24" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <!-- ۴ کارت شاخص‌های کلیدی فروش (CRM KPI Cards) -->
                            <RowDefinition Height="Auto"/>
                            <!-- نوار فیلتر و جستجوی سریع -->
                            <RowDefinition Height="Auto"/>
                            <!-- جدول پیش‌فاکتورها (بدون ستون‌های زائد) -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- بخش ۱: کارت‌های شاخص‌های کلیدی CRM -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- کارت ۱: کل ارزش پیش‌فاکتورها -->
                            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="کل مبالغ پیش‌فاکتورها" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtKpiTotalAmount" Text="0 تومان" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtKpiTotalCount" Text="تعداد: 0 فاکتور صادرشده" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="{StaticResource PrimaryLightBrush}" VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="DocumentBulletList24" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- کارت ۲: تأیید شده (فروش قطعی) -->
                            <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="پیش‌فاکتورهای تأیید شده" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtKpiApprovedAmount" Text="0 تومان" FontSize="17" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtKpiApprovedCount" Text="تعداد: 0 تأیید نهایی" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="{StaticResource SuccessLightBrush}" VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- کارت ۳: در انتظار پیگیری فروش -->
                            <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="در انتظار پیگیری و ارسال" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtKpiPendingCount" Text="0 پیش‌فاکتور" FontSize="17" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/>
                                        <TextBlock Text="نیازمند تماس کارشناس" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="{StaticResource WarningLightBrush}" VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="Clock24" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- کارت ۴: شرکت‌ها و کارشناسان فعال -->
                            <Border Grid.Column="3" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="مشتریان و کارشناسان" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtKpiCompaniesCount" Text="0 شرکت" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtKpiExpertsCount" Text="0 کارشناس فعال" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="{StaticResource SurfaceSubtleBrush}" VerticalAlignment="Top">
                                        <ui:SymbolIcon Symbol="Building24" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- بخش ۲: جعبه فیلتر وضعیت و جستجو -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- چیپ‌های وضعیت ۵ گانه -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="فیلتر وضعیت:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"/>
                                    
                                    <RadioButton x:Name="ChipStatusAll" Content="همه وضعیت‌ها" Style="{StaticResource StatusChipButton}" 
                                                 IsChecked="True" Checked="ChipStatus_Checked"/>

                                    <RadioButton x:Name="ChipStatusDraft" Content="پیش‌نویس" Style="{StaticResource StatusChipButton}" 
                                                 Checked="ChipStatus_Checked"/>

                                    <RadioButton x:Name="ChipStatusSent" Content="ارسال‌شده" Style="{StaticResource StatusChipButton}" 
                                                 Checked="ChipStatus_Checked"/>

                                    <RadioButton x:Name="ChipStatusPending" Content="در انتظار تأیید" Style="{StaticResource StatusChipButton}" 
                                                 Checked="ChipStatus_Checked"/>

                                    <RadioButton x:Name="ChipStatusApproved" Content="تأیید شده" Style="{StaticResource StatusChipButton}" 
                                                 Checked="ChipStatus_Checked"/>

                                    <RadioButton x:Name="ChipStatusCanceled" Content="لغو شده" Style="{StaticResource StatusChipButton}" 
                                                 Checked="ChipStatus_Checked"/>
                                </StackPanel>

                                <!-- فیلدهای جستجو و فیلتر کارشناس -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- جستجوی آنی -->
                                    <ui:TextBox x:Name="TxtSearchInvoice" Grid.Column="0" Margin="0,0,12,0" 
                                                PlaceholderText="جستجو در شماره فاکتور، نام شرکت خریدار یا کارشناس..."
                                                Icon="{ui:SymbolIcon Symbol=Search24}" ClearButtonEnabled="True"
                                                TextChanged="TxtSearchInvoice_TextChanged"/>

                                    <!-- فیلتر کارشناس -->
                                    <ComboBox x:Name="CmbFilterExpert" Grid.Column="1" Margin="0,0,12,0" SelectionChanged="CmbFilterExpert_SelectionChanged"/>

                                    <!-- دکمه رفرش -->
                                    <ui:Button Grid.Column="3" Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowSync24}" 
                                               Content="بروزرسانی جدول" Click="BtnRefreshInvoices_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                            <DataGrid x:Name="DgrInvoices" AutoGenerateColumns="False" SelectionMode="Single"
                                      CanUserResizeColumns="True" CanUserSortColumns="True"
                                      PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp"
                                      MouseDoubleClick="DgrInvoices_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <!-- شماره فاکتور -->
                                    <DataGridTemplateColumn Width="1.2*" MinWidth="115">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="شماره فاکتور" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding InvoiceNumber}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- نام شرکت خریدار -->
                                    <DataGridTemplateColumn Width="2.2*" MinWidth="160">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="شرکت خریدار (طرف حساب)" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
                                                    <TextBlock Text="{Binding CompanyName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center" HorizontalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                                        <ui:SymbolIcon Symbol="Call20" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding CompanyPhone}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- کارشناس صادرکننده -->
                                    <DataGridTemplateColumn Width="1.3*" MinWidth="120">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="کارشناس صادرکننده" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
                                                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Person20" Foreground="{StaticResource PrimaryBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding ExpertName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- تاریخ صدور -->
                                    <DataGridTemplateColumn Width="1.0*" MinWidth="95">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="تاریخ صدور" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding IssueDateShamsi}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- مهلت اعتبار -->
                                    <DataGridTemplateColumn Width="1.0*" MinWidth="95">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="مهلت اعتبار" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ValidUntilShamsi}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- مبلغ کل (تومان) -->
                                    <DataGridTemplateColumn Width="1.4*" MinWidth="125">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="مبلغ کل (تومان)" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N0}}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="تومان" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="4,1,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <!-- وضعیت رنگی ۵ گانه -->
                                    <DataGridTemplateColumn Width="1.1*" MinWidth="100">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="وضعیت" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{Binding Status, Converter={StaticResource StatusToBgColorBrushConverter}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToStringConverter}}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToColorBrushConverter}}"
                                                               FontWeight="Bold" FontSize="11.5"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- دکمه‌های عملیاتی مرتب و منوی شناور -->
                                    <DataGridTemplateColumn Width="3.4*" MinWidth="320">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="عملیات و خروجی" FontWeight="Bold" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- چاپ و PDF -->
                                                    <ui:Button Style="{StaticResource TableActionButton}" Margin="2,0"
                                                               ToolTip="چاپ مستقیم یا خروجی PDF رسمی A4" Click="BtnPrintPdf_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Print20" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,5,0" FontSize="15"/>
                                                            <TextBlock Text="چاپ / PDF" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ui:Button>

                                                    <!-- اکسل مشتری -->
                                                    <ui:Button Style="{StaticResource TableActionButton}" Margin="2,0"
                                                               ToolTip="خروجی فایل اکسل فقط با ستون‌های نهایی مشتری" Click="BtnExportExcel_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="DocumentTable20" Foreground="{StaticResource SuccessBrush}" Margin="0,0,5,0" FontSize="15"/>
                                                            <TextBlock Text="اکسل" FontSize="11" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ui:Button>

                                                    <!-- ویرایش مستقیم -->
                                                    <ui:Button Style="{StaticResource TableActionButton}" Padding="6,3" Margin="2,0"
                                                               ToolTip="ویرایش پیش‌فاکتور" Click="MenuItem_Edit_Click">
                                                        <ui:SymbolIcon Symbol="Edit20" Foreground="{StaticResource PrimaryBrush}" FontSize="14"/>
                                                    </ui:Button>

                                                    <!-- حذف ملایم و شیک (بدون ضربدر سیاه روی کادر قرمز!) -->
                                                    <ui:Button Style="{StaticResource SoftDangerButton}" Margin="2,0"
                                                               ToolTip="حذف پیش‌فاکتور" Click="BtnDeleteInvoice_Click">
                                                        <ui:SymbolIcon Symbol="Delete20" FontSize="14" 
                                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=ui:Button}, Path=Foreground}"/>
                                                    </ui:Button>

                                                    <!-- سایر گزینه‌ها / منوی ۳ نقطه -->
                                                    <ui:Button Style="{StaticResource TableActionButton}" Padding="6,3" Margin="2,0"
                                                               ToolTip="سایر عملیات (کپی، تغییر وضعیت)" Click="BtnMoreOptions_Click">
                                                        <ui:SymbolIcon Symbol="MoreHorizontal20" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                                        <ui:Button.ContextMenu>
                                                            <ContextMenu FlowDirection="RightToLeft" FontFamily="{StaticResource AppFontFamily}">
                                                                <MenuItem Header="ویرایش پیش‌فاکتور (دابل‌کلیک)" Click="MenuItem_Edit_Click">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="Edit20" Foreground="{StaticResource PrimaryBrush}"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="کپی فاکتور با شماره جدید کارشناس" Click="MenuItem_Duplicate_Click">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="Copy20" Foreground="{StaticResource PrimaryBrush}"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="تغییر وضعیت پیش‌فاکتور">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="ArrowSync20" Foreground="{StaticResource PrimaryBrush}"/>
                                                                    </MenuItem.Icon>
                                                                    <MenuItem Header="پیش‌نویس (Draft)" Click="MenuItem_SetStatus_Click" Tag="Draft"/>
                                                                    <MenuItem Header="ارسال‌شده (Sent)" Click="MenuItem_SetStatus_Click" Tag="Sent"/>
                                                                    <MenuItem Header="در انتظار تأیید (Pending Review)" Click="MenuItem_SetStatus_Click" Tag="PendingReview"/>
                                                                    <MenuItem Header="تأیید شده (Approved)" Click="MenuItem_SetStatus_Click" Tag="Approved"/>
                                                                    <MenuItem Header="لغو شده (Canceled)" Click="MenuItem_SetStatus_Click" Tag="Canceled"/>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="حذف پیش‌فاکتور" Foreground="{StaticResource DangerBrush}" Click="MenuItem_Delete_Click">
                                                                    <MenuItem.Icon>
                                                                        <ui:SymbolIcon Symbol="Delete20" Foreground="{StaticResource DangerBrush}"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </ui:Button.ContextMenu>
                                                    </ui:Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- ۲. صفحه فرم صدور / ویرایش پیش‌فاکتور -->
                    <Grid x:Name="ViewInvoiceEditor" Margin="24" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- کارت‌های اطلاعات طرفین -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- کارت خریدار -->
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="مشخصات شرکت خریدار (طرف حساب)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <ui:Button Grid.Column="1" Appearance="Secondary" Padding="10,3" FontSize="11" Content="+ ثبت شرکت جدید" Click="BtnQuickAddCompany_Click"/>
                                            </Grid>

                                            <TextBlock Text="انتخاب شرکت:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbEditorCompany" DisplayMemberPath="Name" SelectionChanged="CmbEditorCompany_SelectionChanged" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="تلفن تماس:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtEditorCompanyPhone"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="کد اقتصادی / شناسه ملی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtEditorCompanyEcoCode"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="نشانی کامل:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                            <ui:TextBox x:Name="TxtEditorCompanyAddress"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- کارت پیش‌فاکتور و کارشناس -->
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="مشخصات پیش‌فاکتور و کارشناس صادرکننده" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="کارشناس صادرکننده:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBlock x:Name="TxtExpertCounterHint" Text="" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="Bold" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                    <ComboBox x:Name="CmbEditorExpert" DisplayMemberPath="FullName" SelectionChanged="CmbEditorExpert_SelectionChanged"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="شماره پیش‌فاکتور (سریال اختصاصی):" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                    <ui:TextBox x:Name="TxtEditorInvoiceNumber" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="تاریخ صدور:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtEditorIssueDate"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                                    <TextBlock Text="مهلت اعتبار:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtEditorValidUntil"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                                    <TextBlock Text="وضعیت فاکتور:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ComboBox x:Name="CmbEditorStatus"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- جدول اقلام پیش‌فاکتور -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="اقلام و محصولات پیش‌فاکتور" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="نام محصول، تعداد، قیمت فروش نهایی و جمع سطر ستون‌های اصلی هستند. با دکمه افزودن محصول یا کلیک روی سلول‌ها نام محصول را بنویسید." 
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <!-- کلید کنترل نمایش محاسبات پیشرفته (Progressive Disclosure) -->
                                            <CheckBox x:Name="ChkAdvancedPricing" Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center"
                                                      Content="نمایش محاسبات پیشرفته (تخفیف و فرمول ۱.۱)"
                                                      FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                      Checked="ChkAdvancedPricing_Toggle" Unchecked="ChkAdvancedPricing_Toggle"/>

                                            <!-- دکمه افزودن محصول با استایل هماهنگ ثانویه -->
                                            <ui:Button Grid.Column="2" Appearance="Secondary" Padding="14,6" Click="BtnAddItem_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Add24" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="افزودن محصول جدید" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:Button>
                                        </Grid>

                                        <DataGrid x:Name="DgrInvoiceItems" AutoGenerateColumns="False" CanUserAddRows="False" 
                                                  SelectionMode="Single" SelectionUnit="CellOrRowHeader" RowHeight="56"
                                                  PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp"
                                                  MinHeight="180" MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <!-- ردیف -->
                                                <DataGridTextColumn Header="ردیف" Binding="{Binding RowNumber}" Width="0.6*" MinWidth="45" IsReadOnly="True"/>
                                                
                                                <!-- ستون محصول (نام کالا یا خدمات) با ویرایشگر بزرگ، واضح و ارگونومیک -->
                                                <DataGridTemplateColumn Header="محصول *" Width="3.2*" MinWidth="220">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                                <TextBlock Text="{Binding ItemName}" 
                                                                           VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                                           TextAlignment="Center" TextWrapping="Wrap" 
                                                                           FontSize="13.5" FontWeight="SemiBold" 
                                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <Grid VerticalAlignment="Center" Margin="2">
                                                                <ui:TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" 
                                                                            PlaceholderText="نام کالا یا محصول را وارد کنید..."
                                                                            FontSize="14" FontWeight="SemiBold"
                                                                            Height="42" Padding="10,6"
                                                                            VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                                            Loaded="TxtItemName_Loaded"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                                
                                                <!-- تعداد -->
                                                <DataGridTextColumn Header="تعداد *" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:G29}}" Width="0.8*" MinWidth="65"/>
                                                
                                                <!-- قیمت خام واحد -->
                                                <DataGridTextColumn x:Name="ColRawPrice" Header="قیمت خام (تومان)" 
                                                                    Binding="{Binding RawPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Width="1.3*" MinWidth="110" Visibility="Collapsed"/>
                                                
                                                <!-- درصد تخفیف فروش -->
                                                <DataGridTextColumn x:Name="ColDiscountPercent" Header="تخفیف %" 
                                                                    Binding="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" Width="0.8*" MinWidth="65" Visibility="Collapsed"/>
                                                
                                                <!-- مبلغ تخفیف واحد -->
                                                <DataGridTextColumn x:Name="ColDiscountAmount" Header="مبلغ تخفیف" 
                                                                    Binding="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Width="1.1*" MinWidth="95" Visibility="Collapsed"/>

                                                <!-- تیک ویژه محاسبه تقسیم بر ۱.۱ -->
                                                <DataGridCheckBoxColumn x:Name="Col1Point1" Header="تقسیم بر ۱.۱ (معکوس ارزش‌افزوده)" 
                                                                        Binding="{Binding IsDividedBy1Point1, UpdateSourceTrigger=PropertyChanged}" Width="1.4*" MinWidth="120" Visibility="Collapsed"/>

                                                <!-- قیمت نهایی فروش (خروجی مشتری) -->
                                                <DataGridTextColumn Header="قیمت فروش نهایی (تومان) *" 
                                                                    Binding="{Binding FinalUnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Width="1.5*" MinWidth="130" FontWeight="Bold"/>

                                                <!-- مبلغ کل سطر -->
                                                <DataGridTextColumn Header="مبلغ کل سطر (تومان)" 
                                                                    Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="1.5*" MinWidth="130" IsReadOnly="True" FontWeight="Bold"/>

                                                <!-- عملیات حذف سطر -->
                                                <DataGridTemplateColumn Header="حذف" Width="0.7*" MinWidth="55">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ui:Button Style="{StaticResource SoftDangerButton}" ToolTip="حذف این سطر" Click="BtnRemoveItem_Click">
                                                                <ui:SymbolIcon Symbol="Delete20" FontSize="14"/>
                                                            </ui:Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <!-- کارت‌های خلاصه مالی -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- جمع ناخالص -->
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="مجموع قیمت خام ناخالص:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtSummaryRawTotal" Text="0 تومان" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- مجموع تخفیف‌ها -->
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="مجموع تخفیف‌های اعطا شده:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtSummaryDiscountTotal" Text="0 تومان" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- جمع نهایی فاکتور: کارت برجسته مدیریتی آبی کبالت (جایگزین کارت سبز ناهماهنگ) -->
                                    <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" CornerRadius="10" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" Padding="16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="جمع کل نهایی قابل پرداخت:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                <Border Grid.Column="1" Background="{StaticResource PrimaryLightBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="مبلغ نهایی فروش" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="TxtSummaryGrandTotal" Text="0 تومان" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,2"/>
                                            <TextBlock x:Name="TxtSummaryGrandTotalWords" Text="صفر تومان" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- توضیحات و دکمه‌های اقدام: سلسله‌مراتب دقیق ۱ اکشن اصلی (Strict 1-Primary Hierarchy) -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,24">
                                    <StackPanel>
                                        <TextBlock Text="شرایط پرداخت و توضیحات پیش‌فاکتور:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <ui:TextBox x:Name="TxtEditorNotes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Height="65" Margin="0,0,0,16"/>

                                        <StackPanel Orientation="Horizontal">
                                            <!-- تنها دکمه پررنگ Primary در این صفحه: ذخیره پیش‌فاکتور -->
                                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" 
                                                       Content="ذخیره پیش‌فاکتور" Padding="22,10" FontSize="13" FontWeight="Bold" Margin="0,0,10,0" Click="BtnSaveInvoice_Click"/>

                                            <!-- اقدامات ثانویه با آیکون‌های تمیز و بدون اغتشاش رنگی -->
                                            <ui:Button Appearance="Secondary" Padding="16,10" FontSize="12.5" Margin="0,0,10,0" Click="BtnSaveAndExportExcel_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="DocumentTable24" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="ذخیره و صدور اکسل مشتری" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:Button>

                                            <ui:Button Appearance="Secondary" Padding="16,10" FontSize="12.5" Margin="0,0,10,0" Click="BtnSaveAndPrintPdf_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Print24" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="ذخیره و چاپ / PDF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ui:Button>

                                            <ui:Button Appearance="Secondary" Content="انصراف و بازگشت" Padding="16,10" FontSize="12.5" Click="BtnCancelEditor_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ۳. صفحه شرکت‌ها -->
                    <Grid x:Name="ViewCompanies" Margin="24" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,16,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="فهرست شرکت‌های خریدار (مشتریان)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add24}" Content="شرکت جدید" Click="BtnNewCompany_Click"/>
                                </Grid>

                                <DataGrid x:Name="DgrCompanies" Grid.Row="1" AutoGenerateColumns="False" 
                                          PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp"
                                          SelectionChanged="DgrCompanies_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="نام شرکت" Binding="{Binding Name}" Width="2.5*" MinWidth="150" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="کد اقتصادی" Binding="{Binding EconomicCode}" Width="1.4*" MinWidth="110"/>
                                        <DataGridTextColumn Header="شناسه ملی" Binding="{Binding NationalCode}" Width="1.3*" MinWidth="100"/>
                                        <DataGridTextColumn Header="تلفن" Binding="{Binding Phone}" Width="1.3*" MinWidth="100"/>
                                        
                                        <DataGridTemplateColumn Header="عملیات" Width="1.5*" MinWidth="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ui:Button Style="{StaticResource TableActionButton}" Margin="3,0" ToolTip="ویرایش شرکت" Click="BtnEditCompany_Click">
                                                            <ui:SymbolIcon Symbol="Edit20" FontSize="14" Foreground="#2563EB"/>
                                                        </ui:Button>
                                                        <ui:Button Style="{StaticResource SoftDangerButton}" Margin="3,0" ToolTip="حذف شرکت" Click="BtnDeleteCompany_Click">
                                                            <ui:SymbolIcon Symbol="Delete20" FontSize="14"/>
                                                        </ui:Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- فرم ثبت شرکت -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock x:Name="TxtCompanyFormTitle" Text="ثبت شرکت جدید" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                                <TextBlock Text="نام شرکت / شخص حقوقی *:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtCompanyName" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="کد اقتصادی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <ui:TextBox x:Name="TxtCompanyEconomicCode"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="شناسه ملی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <ui:TextBox x:Name="TxtCompanyNationalCode"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="شماره ثبت:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <ui:TextBox x:Name="TxtCompanyRegistrationNo"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="تلفن تماس:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <ui:TextBox x:Name="TxtCompanyPhone"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="نشانی کامل:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtCompanyAddress" Margin="0,0,0,10"/>

                                <TextBlock Text="توضیحات:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtCompanyDescription" AcceptsReturn="True" Height="60" Margin="0,0,0,16"/>

                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" Content="ذخیره شرکت" Click="BtnSaveCompany_Click" Margin="0,0,8,0"/>
                                    <ui:Button Appearance="Secondary" Content="انصراف" Click="BtnClearCompanyForm_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ۴. صفحه کارشناسان -->
                    <Grid x:Name="ViewExperts" Margin="24" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,16,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="فهرست کارشناسان فروش با شماره‌انداز مستقل" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Add24}" Content="کارشناس جدید" Click="BtnNewExpert_Click"/>
                                </Grid>

                                <DataGrid x:Name="DgrExperts" Grid.Row="1" AutoGenerateColumns="False" 
                                          PreviewMouseLeftButtonUp="DataGrid_PreviewMouseLeftButtonUp"
                                          SelectionChanged="DgrExperts_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="نام کارشناس" Binding="{Binding FullName}" Width="1.8*" MinWidth="130" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="سمت" Binding="{Binding RoleTitle}" Width="1.4*" MinWidth="110"/>
                                        <DataGridTextColumn Header="پیشوند فاکتور" Binding="{Binding InvoicePrefix}" Width="1.2*" MinWidth="95"/>
                                        <DataGridTextColumn Header="شماره بعدی" Binding="{Binding NextInvoiceNumber}" Width="1.2*" MinWidth="95" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="تلفن" Binding="{Binding PhoneNumber}" Width="1.2*" MinWidth="100"/>

                                        <DataGridTemplateColumn Header="عملیات" Width="1.4*" MinWidth="115">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ui:Button Style="{StaticResource TableActionButton}" Margin="3,0" ToolTip="ویرایش کارشناس" Click="BtnEditExpert_Click">
                                                            <ui:SymbolIcon Symbol="Edit20" FontSize="14" Foreground="#2563EB"/>
                                                        </ui:Button>
                                                        <ui:Button Style="{StaticResource SoftDangerButton}" Margin="3,0" ToolTip="حذف کارشناس" Click="BtnDeleteExpert_Click">
                                                            <ui:SymbolIcon Symbol="Delete20" FontSize="14"/>
                                                        </ui:Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- فرم کارشناس -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock x:Name="TxtExpertFormTitle" Text="ثبت کارشناس جدید" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                                <TextBlock Text="نام و نام خانوادگی کارشناس *:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtExpertFullName" Margin="0,0,0,10"/>

                                <TextBlock Text="سمت / عنوان شغلی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtExpertRole" Text="کارشناس فروش" Margin="0,0,0,10"/>

                                <!-- کادر شماره‌گذاری مستقل -->
                                <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="تنظیمات شماره‌گذاری اختصاصی پیش‌فاکتور:" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                        
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="پیشوند فاکتور:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ui:TextBox x:Name="TxtExpertPrefix" Text="EXP-" TextChanged="TxtExpertNumbering_TextChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="شمارنده بعدی:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ui:TextBox x:Name="TxtExpertNextNum" Text="1001" TextChanged="TxtExpertNumbering_TextChanged"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock x:Name="TxtExpertNumberPreview" Text="پیش‌نمایش: EXP-1001" 
                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="تلفن همراه:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtExpertPhone" Margin="0,0,0,10"/>

                                <TextBlock Text="ایمیل:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtExpertEmail" Margin="0,0,0,16"/>

                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" Content="ذخیره کارشناس" Click="BtnSaveExpert_Click" Margin="0,0,8,0"/>
                                    <ui:Button Appearance="Secondary" Content="انصراف" Click="BtnClearExpertForm_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ۵. صفحه قالب اکسل و تنظیمات -->
                    <Grid x:Name="ViewSettings" Margin="24" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- قالب اکسل -->
                                <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,14,0" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="قالب اختصاصی اکسل" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="می‌توانید فایل اکسل آماده شرکت خود را معرفی کنید تا سیستم اطلاعات فاکتور را بدون تغییر استایل در آن بنشاند." 
                                                   TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>

                                        <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="قالب فعال سیستم:" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox x:Name="TxtTemplatePath" IsReadOnly="True" Grid.Column="0" Margin="0,0,8,0"/>
                                                    <ui:Button Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" Content="انتخاب قالب..." Click="BtnBrowseTemplate_Click"/>
                                                </Grid>
                                                <ui:Button Appearance="Secondary" Content="بازگشت به قالب پیش‌فرض استاندارد" HorizontalAlignment="Left" Click="BtnClearTemplate_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="💡 ایجاد فایل نمونه قالب اکسل" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="ایجاد یک فایل اکسل نمونه روی دسکتاپ با تمام تگ‌های متناظر جهت سهولت در طراحی قالب خودتان." 
                                                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                                <ui:Button Appearance="Secondary" Padding="14,6" Click="BtnCreateSampleTemplate_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="ایجاد قالب نمونه روی دسکتاپ" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ui:Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- مشخصات فروشنده و بک‌آپ -->
                                <StackPanel Grid.Column="1">
                                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,14" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="مشخصات شرکت ما (فروشنده)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                            <TextBlock Text="نام شرکت فروشنده:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                            <ui:TextBox x:Name="TxtSellerName" Margin="0,0,0,8"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="شناسه ملی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtSellerNatCode"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="کد اقتصادی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                    <ui:TextBox x:Name="TxtSellerEcoCode"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="تلفن تماس:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                            <ui:TextBox x:Name="TxtSellerPhone" Margin="0,0,0,8"/>

                                            <TextBlock Text="نشانی:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                            <ui:TextBox x:Name="TxtSellerAddress" Margin="0,0,0,12"/>

                                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" Content="ذخیره مشخصات فروشنده" Click="BtnSaveSellerSettings_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="پشتیبان‌گیری از اطلاعات" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <TextBlock Text="تهیه فایل پشتیبان از تمام فاکتورها، شرکت‌ها و کارشناسان." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>

                                            <StackPanel Orientation="Horizontal">
                                                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Symbol=Save24}" Content="تهیه پشتیبان (Backup)" Margin="0,0,8,0" Click="BtnBackup_Click"/>
                                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" Content="بازیابی (Restore)" Click="BtnRestore_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                </Grid>

                <!-- نوار وضعیت پایین -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtStatusMessage" Text="آماده به‌کار" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="تـراز • سامانه جامع مدیریت فروش و پیش‌فاکتور (نسخه پیش‌آلفا v0.1.0-pre-alpha)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
