; Script generated by Antigravity for Taraz Invoice Setup
#define MyAppName "تـراز - سامانه جامع صدور و مدیریت پیش‌فاکتور"
#define MyAppEnglishName "Taraz Invoice"
#define MyAppVersion "1.0.1"
#define MyAppPublisher "شرکت آریان نیرو گستر اترک"
#define MyAppExeName "TarazInvoice.exe"
#define MySourceDir "publish\app"
#define MyOutputDir "publish"
#define MyIconFile "Resources\logo.ico"

[Setup]
AppId={{D37F8E92-7A1C-4B9F-83D2-4C9820261122}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={autopf}\TarazInvoice
DefaultGroupName=تـراز (سامانه پیش‌فاکتور)
AllowNoIcons=yes
OutputDir={#MyOutputDir}
OutputBaseFilename=TarazInvoice_Setup_v1.0.1
SetupIconFile={#MyIconFile}
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
DisableProgramGroupPage=yes
ArchitecturesInstallIn64BitMode=x64compatible
UninstallDisplayIcon={app}\{#MyAppExeName}

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "ایجاد میانبر روی دسکتاپ (Create Desktop Shortcut)"; GroupDescription: "میانبرها:"; Flags: checkedonce

[Files]
Source: "{#MySourceDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#MyIconFile}"; DestDir: "{app}"; Flags: ignoreversion

[Dirs]
Name: "{app}\Data"; Permissions: users-full

[Icons]
Name: "{autoprograms}\تـراز (Taraz Invoice)"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\logo.ico"
Name: "{autodesktop}\تـراز (Taraz Invoice)"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon; IconFilename: "{app}\logo.ico"

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "اجرای برنامه تـراز (Launch Taraz Invoice)"; Flags: nowait postinstall skipifsilent
